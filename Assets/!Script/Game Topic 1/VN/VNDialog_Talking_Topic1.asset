  m_Name: VNDialog_Talking_Topic1
  m_EditorClassIdentifier: 
  playerName: Kamu
  npcName: Rio
  playerPortrait: {fileID: 21300000, guid: 91753b50188160e469f1596dd7b4e6be, type: 3}
  playerTalkingPortrait: {fileID: 21300000, guid: 6f7b85b4da78fd74eb50431daa554c0f, type: 3}
  playerThinkingPortrait: {fileID: 0}
  playerSmilingPortrait: {fileID: 0}
  femalePlayerPortrait: {fileID: 21300000, guid: 457d9f7f459322e4ebd9f545fabd4566, type: 3}
  femalePlayerTalkingPortrait: {fileID: 21300000, guid: f4ffd3f5ee3068b4d9fc4a49eb3eb079, type: 3}
  femalePlayerThinkingPortrait: {fileID: 0}
  femalePlayerSmilingPortrait: {fileID: 0}
  npc2Name: Bagas
  npcPortrait: {fileID: 21300000, guid: 8aad04948ca6d534dbdb5f3b12a33db0, type: 3}
  npcTalkingPortrait: {fileID: 0}
  npcThinkingPortrait: {fileID: 0}
  npcSmilingPortrait: {fileID: 0}
  npc2Portrait: {fileID: 21300000, guid: 8dc32b37f5869534d9d590054a3ec38d, type: 3}
  npc2TalkingPortrait: {fileID: 0}
  npc2ThinkingPortrait: {fileID: 0}
  npc2SmilingPortrait: {fileID: 0}
  background: {fileID: 21300000, guid: 409ebc58de7629d4ebfcf64e117104d5, type: 3}
  lines:
  - speaker: 1
    mood: 1
    expression: {fileID: 0}
    text: "Eh, muka lo kayak orang nyasar! \nAnak baru IT Support ya? Haha."
    voiceClip: {fileID: 8300000, guid: c67b7e5ca69a7814abb94efa1ee33aa7, type: 3}
    femalePlayerVoiceClip: {fileID: 0}
  - speaker: 0
    mood: 1
    expression: {fileID: 0}
    text: Ketahuan ya... hampir masuk ruang server tadi.
    voiceClip: {fileID: 8300000, guid: 09257e76b3aa86f4b8aa296c074e26c6, type: 3}
    femalePlayerVoiceClip: {fileID: 8300000, guid: aab18529c19dff24ba4593216602b935, type: 3}
  - speaker: 3
    mood: 3
    expression: {fileID: 0}
    text: "Hahaha klasik! Sini duduk dulu, \nminum kopi biar ga keliatan panik."
    voiceClip: {fileID: 8300000, guid: 445a665e6a4033845aaa1abe7c0e7819, type: 3}
    femalePlayerVoiceClip: {fileID: 0}
  - speaker: 0
    mood: 1
    expression: {fileID: 0}
    text: Wah makasih! Kalian baik banget.
    voiceClip: {fileID: 8300000, guid: e311b591ae98f0d43816a82d90874769, type: 3}
    femalePlayerVoiceClip: {fileID: 8300000, guid: 17fc0aa7970b3af45b0da387cf86702b, type: 3}
  - speaker: 1
    mood: 2
    expression: {fileID: 0}
    text: "Ngomong-ngomong... kamu IT Support kan? \nAda insiden yang perlu lo tahu."
    voiceClip: {fileID: 8300000, guid: 7a5e4dfbdab64ce428d5e8f92e06878c, type: 3}
    femalePlayerVoiceClip: {fileID: 0}
  - speaker: 0
    mood: 1
    expression: {fileID: 0}
    text: Insiden apa?
    voiceClip: {fileID: 8300000, guid: fdc92350216493f47af56b4bbff54bf5, type: 3}
    femalePlayerVoiceClip: {fileID: 8300000, guid: 0ea4fd3ce92b39e46ac90a234b1ad6b8, type: 3}
  - speaker: 3
    mood: 2
    expression: {fileID: 0}
    text: "Kemarin ada orang masuk ngaku dari vendor, \nminta install 'update' di
      komputer HRD."
    voiceClip: {fileID: 8300000, guid: 57e4899e9677e3b44b3c30122aa51926, type: 3}
    femalePlayerVoiceClip: {fileID: 0}
  - speaker: 3
    mood: 0
    expression: {fileID: 0}
    text: "File kepegawaian nyaris kekirim keluar. \nTernyata orang itu bukan vendor
      sama sekali."
    voiceClip: {fileID: 8300000, guid: 6f1e9af4e44d27142affb99e2329ca00, type: 3}
    femalePlayerVoiceClip: {fileID: 0}
  - speaker: 0
    mood: 1
    expression: {fileID: 0}
    text: Itu social engineering... Gila.
    voiceClip: {fileID: 8300000, guid: f19b6376562c1394dba27cd74b9b302f, type: 3}
    femalePlayerVoiceClip: {fileID: 8300000, guid: de0b136d766111840b8d52aacde1ff32, type: 3}
  - speaker: 1
    mood: 1
    expression: {fileID: 0}
    text: "Nah. Jadi kalau ada yang minta kamu install sesuatu \natau minta akses,
      sekecil apapun tanya dulu ke supervisor."
    voiceClip: {fileID: 8300000, guid: b358ca7f61fa04b479e7fed1a75d11f4, type: 3}
    femalePlayerVoiceClip: {fileID: 0}
  - speaker: 3
    mood: 1
    expression: {fileID: 0}
    text: Dan kalau ada yang ngaku IT Support tapi lo ga pernah lihat sebelumnya,
      verifikasi dulu identitasnya lewat HR.
    voiceClip: {fileID: 8300000, guid: d82c28b9b2a67ca4eaa17658b3f5126b, type: 3}
    femalePlayerVoiceClip: {fileID: 0}
  - speaker: 1
    mood: 1
    expression: {fileID: 0}
    text: Oke serius dulu tadi. Sekarang santai!  Welcome to the team, bro.
    voiceClip: {fileID: 8300000, guid: 737fdadf2c892fe4eb1522305ea41dd4, type: 3}
    femalePlayerVoiceClip: {fileID: 0}
  - speaker: 0
    mood: 0
    expression: {fileID: 0}
    text: Thanks Rio, Bagas. Berguna banget nih  buat hari pertama. Aku traktir kopi
      besok!
    voiceClip: {fileID: 8300000, guid: 6e5e1349013e80c46b368aa9fde1f16c, type: 3}
    femalePlayerVoiceClip: {fileID: 8300000, guid: eae81ea55a3b9f847a4c09697d11bd64, type: 3}
  hasChoice: 0
  acceptText: Ya
  rejectText: Tidak
  dialogueIfAccepted: {fileID: 0}
  dialogueIfRejected: {fileID: 0}
  actionID: NPC_Talking1and2
