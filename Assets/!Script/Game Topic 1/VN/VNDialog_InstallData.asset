  playerName: Kamu
  npcName: Pak Budi
  playerPortrait: {fileID: 21300000, guid: 91753b50188160e469f1596dd7b4e6be, type: 3}
  playerTalkingPortrait: {fileID: 21300000, guid: 6f7b85b4da78fd74eb50431daa554c0f, type: 3}
  playerThinkingPortrait: {fileID: 0}
  playerSmilingPortrait: {fileID: 0}
  npc2Name: 
  npcPortrait: {fileID: 21300000, guid: b6529a954a0d07f44935fa59e90116e2, type: 3}
  npcTalkingPortrait: {fileID: 0}
  npcThinkingPortrait: {fileID: 0}
  npcSmilingPortrait: {fileID: 0}
  npc2Portrait: {fileID: 0}
  npc2TalkingPortrait: {fileID: 0}
  npc2ThinkingPortrait: {fileID: 0}
  npc2SmilingPortrait: {fileID: 0}
  background: {fileID: 21300000, guid: fe3ca41fcc1f30148992e34f1ec6e6c6, type: 3}
  lines:
  - speaker: 1
    mood: 0
    expression: {fileID: 0}
    text: Hei kamu! IT Support yang baru ya?
    voiceClip: {fileID: 8300000, guid: 6edf149631d54413933426300b239fe0, type: 3}
  - speaker: 0
    mood: 1
    expression: {fileID: 0}
    text: Iya Pak, saya anak IT Support baru disini.
    voiceClip: {fileID: 8300000, guid: 98984a73d01946b38a55c9ac4b581b07, type: 3}
  - speaker: 1
    mood: 0
    expression: {fileID: 0}
    text: "Pas banget nih. Ini ada email masuk \u2014 katanya update software akuntansi
      baru."
    voiceClip: {fileID: 8300000, guid: 8c928a3eb8674c7faabf215ed7b6c75f, type: 3}
  - speaker: 1
    mood: 1
    expression: {fileID: 0}
    text: Tolong install di laptop aku ya. Divisi Finance semua sudah pakai versi
      ini katanya.
    voiceClip: {fileID: 8300000, guid: 1564117ed54d414289125fea9ff4bdee, type: 3}
  - speaker: 0
    mood: 2
    expression: {fileID: 0}
    text: "(Software akuntansi dikirim lewat email? \nItu bukan prosedur standar...)"
    voiceClip: {fileID: 8300000, guid: 29be710e121440deab11139803433070, type: 3}
  - speaker: 0
    mood: 1
    expression: {fileID: 0}
    text: "Pak, biasanya update software resmi itu \ntidak dikirim lewat email, harus
      lewat jalur IT."
    voiceClip: {fileID: 8300000, guid: d0ca83e892cc4e20aea8cca9dc525694, type: 3}
  - speaker: 1
    mood: 0
    expression: {fileID: 0}
    text: "Ih, kamu terlalu ribet. \nIni dari teman aku di Finance, aman kok."
    voiceClip: {fileID: 8300000, guid: e71ea16bbeaf430681da53a289e8f03a, type: 3}
  - speaker: 1
    mood: 0
    expression: {fileID: 0}
    text: "Aku mau meeting sebentar lagi. \nCepet ya ,5 menit aja."
    voiceClip: {fileID: 8300000, guid: 9fca96c95dc44fe4b07a3b13fe2a3190, type: 3}
  - speaker: 2
    mood: 0
    expression: {fileID: 0}
    text: "(File dari email tidak dikenal, dikirim bukan lewat \nsistem IT resmi,
      dengan tekanan waktu.)"
  - speaker: 2
    mood: 0
    expression: {fileID: 0}
    text: (Install file ini, atau tolak dan lapor ke supervisor?)
  hasChoice: 1
  acceptText: Oke Pak, saya install.
  rejectText: Maaf Pak, saya harus verifikasi dulu.
  dialogueIfAccepted: {fileID: 0}
  dialogueIfRejected: {fileID: 0}
  actionID: VN_Receptionist_Topic1
