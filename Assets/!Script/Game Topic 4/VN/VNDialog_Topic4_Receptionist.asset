  npcTalkingPortrait: {fileID: 21300000, guid: 79b4712106820ac4bbe4d0dd6cc0152f, type: 3}
  npcThinkingPortrait: {fileID: 21300000, guid: 79b4712106820ac4bbe4d0dd6cc0152f, type: 3}
  npcSmilingPortrait: {fileID: 21300000, guid: 79b4712106820ac4bbe4d0dd6cc0152f, type: 3}
