  npcTalkingPortrait: {fileID: 21300000, guid: e65ff769b15391c4685a4d4541b72635, type: 3}
  npcThinkingPortrait: {fileID: 21300000, guid: e65ff769b15391c4685a4d4541b72635, type: 3}
