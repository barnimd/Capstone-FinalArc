  npc2Name: Rafi
  npcPortrait: {fileID: 21300000, guid: b143d1efbbb53cd4fb6baa979d37f931, type: 3}
  npcTalkingPortrait: {fileID: 21300000, guid: b143d1efbbb53cd4fb6baa979d37f931, type: 3}
  npcThinkingPortrait: {fileID: 21300000, guid: b143d1efbbb53cd4fb6baa979d37f931, type: 3}
