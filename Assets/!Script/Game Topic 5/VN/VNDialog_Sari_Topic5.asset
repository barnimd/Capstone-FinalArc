  lines:
  - speaker: 1
    mood: 3
    expression: {fileID: 0}
    text: Selamat datang di CafeBean! Mau pesan apa?
    voiceClip: {fileID: 8300000, guid: 7395748e05a36d24d97b211db242b2e4, type: 3}
    femalePlayerVoiceClip: {fileID: 0}
  - speaker: 0
    mood: 0
    expression: {fileID: 0}
    text: Hei, satu americano ya. Oh iya, nama Wi-Fi-nya apa?
    voiceClip: {fileID: 8300000, guid: 99667e043dbf53a4fbe244c83330ce54, type: 3}
    femalePlayerVoiceClip: {fileID: 8300000, guid: 2b48b02af4a465842a56c4c34d0f3ece, type: 3}
  - speaker: 1
    mood: 0
    expression: {fileID: 0}
    text: Wi-Fi kita namanya CafeBean_Free, password-nya ada di papan kecil dekat
      tanaman di pojok. Kalau ada yang aneh, langsung bilang ke kami ya!
    voiceClip: {fileID: 8300000, guid: c23b4a4a3dc58ce4ea70db576a76e61c, type: 3}
    femalePlayerVoiceClip: {fileID: 0}
  - speaker: 0
    mood: 3
    expression: {fileID: 0}
    text: Oke, makasih!
    voiceClip: {fileID: 8300000, guid: a5eca459c102e14459db14ac589fb169, type: 3}
    femalePlayerVoiceClip: {fileID: 8300000, guid: 81ea26b147f06644d9f5faa0f4c1af61, type: 3}
  - speaker: 2
    mood: 0
    expression: {fileID: 0}
    text: '{PLAYER_NAME} melihat sekeliling. Kafe cukup ramai. Beberapa orang sibuk
      dengan laptop masing-masing.'
    voiceClip: {fileID: 0}
    femalePlayerVoiceClip: {fileID: 0}
  hasChoice: 0
  acceptText: Ya
  rejectText: Tidak
