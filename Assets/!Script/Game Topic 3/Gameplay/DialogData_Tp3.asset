%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d1a9764ef7be26448ae3f30dcedc0b72, type: 3}
  m_Name: DialogData_Tp3
  m_EditorClassIdentifier: 
  lines:
  - speakerName: Joji
    text: '"Permisi... eh, halo! Kamu Arunika kan? Aku Joji, baru mulai hari ini."'
  - speakerName: Arunika
    text: '"Oh! Joji! Iya aku Arunika, seneng ketemu kamu. Selamat datang di tim!"'
  - speakerName: Arunika
    text: '"Oh iya, tadi ada email masuk ke inbox kamu. Katanya dari IT Department,
      minta klik link buat verifikasi akun."'
  - speakerName: Joji
    text: '"Wah serius? Baru hari pertama udah ada email penting. Langsung aku klik
      aja kali ya?"'
  - speakerName: Arunika
    text: '"Eh tunggu dulu! Jangan buru-buru. Aku curiga itu bukan email dari kantor
      kita."'
  - speakerName: Joji
    text: '"Hah? Emangnya kenapa? Kan katanya dari IT Department..."'
  - speakerName: Arunika
    text: '"Coba pastiin dulu isi email nya. Takut nya terjadi hal yang tidak di
      inginkan."'
  - speakerName: Joji
    text: '"Oh... iya ya, aku nggak kepikiran sampai sana. Ada tips cara bedainnya?"'
  - speakerName: Arunika
    text: '"Lihat isi pesannya. Kalau pakai kata-kata kayak ''SEGERA!'', ''akun kamu
      akan diblokir'' bisa jadi taktik urgency. Sengaja dibuat panik biar kamu nggak
      mikir panjang."'
  - speakerName: Joji
    text: '"Wah bahaya juga ya. Berarti aku nggak boleh klik link-nya?"'
  - speakerName: Arunika
    text: '"Tepat. Jangan pernah klik link di email yang nggak kamu minta, apalagi
      kalau minta password atau data pribadi."'
  - speakerName: Joji
    text: '"Oke oke, aku ngerti sekarang. Makasih banyak ya Arunika, untung kamu
      ingetin!"'
  - speakerName: Arunika
    text: '"Sama-sama! Yaudah, sekarang coba cek sendiri emailnya di meja operator
      kamu. Lihat apakah kamu bisa bedain mana yang asli dan mana yang phishing!"'
  objectiveAfterDialog: '"Pergi ke meja operator dan periksa email kamu"'
