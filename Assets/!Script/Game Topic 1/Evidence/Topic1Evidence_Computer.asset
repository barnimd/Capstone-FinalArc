  m_Script: {fileID: 11500000, guid: 1e7bb3955bbc5fb479681c5d8e5a9bfd, type: 3}
  m_Name: Topic1Evidence_Computer
  m_EditorClassIdentifier: 
  contextId: computer
  title: Tinjau Permintaan File
  scenario: Tinjau kembali permintaan pengiriman file yang muncul pada komputer.
    Tandai red flag yang seharusnya diperiksa.
  evidenceOptions:
  - File yang diminta berisi informasi finansial sensitif.
  - Identitas dan kewenangan peminta belum diverifikasi.
  - Permintaan mendorong pengiriman langsung tanpa jalur resmi.
  - Permintaan muncul melalui aplikasi chat kantor.
  evidenceIds:
  - sensitive_financial_file
  - unverified_authority
  - bypasses_official_channel
  - office_chat_channel
  redFlagIndices: 000000000100000002000000
  safeActionText: Tolak pengiriman
  unsafeActionText: Kirim file
  safeFeedback: Keputusan aman. Menolak sementara memberi waktu untuk memverifikasi
    identitas, kewenangan, dan jalur pengiriman yang benar.
  unsafeFeedback: Keputusan berisiko. Mengirim data sebelum verifikasi dapat menyebabkan
    kebocoran informasi sensitif.
  unsafePenalty: -25
