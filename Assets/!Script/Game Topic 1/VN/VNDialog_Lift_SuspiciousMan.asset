  m_Name: VNDialog_Lift_SuspiciousMan
  m_EditorClassIdentifier: 
  playerName: Kamu
  npcName: Rizal(?)
  playerPortrait: {fileID: 21300000, guid: 91753b50188160e469f1596dd7b4e6be, type: 3}
  playerTalkingPortrait: {fileID: 21300000, guid: 6f7b85b4da78fd74eb50431daa554c0f, type: 3}
  playerThinkingPortrait: {fileID: 0}
  playerSmilingPortrait: {fileID: 0}
  femalePlayerPortrait: {fileID: 21300000, guid: 457d9f7f459322e4ebd9f545fabd4566, type: 3}
  femalePlayerTalkingPortrait: {fileID: 21300000, guid: f4ffd3f5ee3068b4d9fc4a49eb3eb079, type: 3}
  femalePlayerThinkingPortrait: {fileID: 0}
  femalePlayerSmilingPortrait: {fileID: 0}
  npc2Name: 
  npcPortrait: {fileID: 21300000, guid: 73896fe4f27144945b5e3d3c555552d5, type: 3}
  npcTalkingPortrait: {fileID: 0}
  npcThinkingPortrait: {fileID: 0}
  npcSmilingPortrait: {fileID: 0}
  npc2Portrait: {fileID: 0}
  npc2TalkingPortrait: {fileID: 0}
  npc2ThinkingPortrait: {fileID: 0}
  npc2SmilingPortrait: {fileID: 0}
  background: {fileID: 21300000, guid: d42e18970fada554fa2e1a4a29563b7b, type: 3}
  lines:
  - speaker: 2
    mood: 0
    expression: {fileID: 0}
    text: "Kamu memasuki lift sendirian. \nSesaat kemudian, seseorang masuk \u2014
      tampak terburu-buru."
    voiceClip: {fileID: 0}
    femalePlayerVoiceClip: {fileID: 0}
  - speaker: 1
    mood: 0
    expression: {fileID: 0}
    text: "Eh hei! Kamu yang anak IT Support baru kan? \nKebetulan banget ketemu
      di sini."
    voiceClip: {fileID: 8300000, guid: 7a70a0b1a09a4fdeb82596a1980df50a, type: 3}
    femalePlayerVoiceClip: {fileID: 0}
  - speaker: 0
    mood: 1
    expression: {fileID: 0}
    text: Eh, iya. Maaf, kita pernah ketemu?
    voiceClip: {fileID: 8300000, guid: ed1018218e0a4f3e8a1822b99782b95e, type: 3}
    femalePlayerVoiceClip: {fileID: 8300000, guid: 81aa096b92d5e1b4fba3abc9080fa74a, type: 3}
  - speaker: 1
    mood: 1
    expression: {fileID: 0}
    text: "Aku Rizal, divisi Finance. \nLo pasti belum hapal muka semua orang haha."
    voiceClip: {fileID: 8300000, guid: a9120b6882f14b9489b612bd2b3681f6, type: 3}
    femalePlayerVoiceClip: {fileID: 0}
  - speaker: 0
    mood: 0
    expression: {fileID: 0}
    text: "(Kamu sama sekali tidak ingat pernah melihat \norang ini di briefing hari
      ini.)"
    voiceClip: {fileID: 8300000, guid: 80c73283d3fc4304a244cc36163dff4e, type: 3}
    femalePlayerVoiceClip: {fileID: 8300000, guid: 1bbda508c8baece4ea2d64ec14a04fce, type: 3}
  - speaker: 1
    mood: 0
    expression: {fileID: 0}
    text: "Dengerin, aku butuh bantuan urgent banget nih. \nBos aku minta laporan
      Q3 Finance sebelum jam 3."
    voiceClip: {fileID: 8300000, guid: 7daf910cf7a24f24976701ccc8e594ee, type: 3}
    femalePlayerVoiceClip: {fileID: 0}
  - speaker: 1
    mood: 0
    expression: {fileID: 0}
    text: "Sistem gue error, ga bisa akses foldernya sendiri. \nBisa kirimin file
      dari komputer lo? Folder Finance Q3."
    voiceClip: {fileID: 8300000, guid: 6735fd9d55004d94a48643b1579de910, type: 3}
    femalePlayerVoiceClip: {fileID: 0}
  - speaker: 0
    mood: 0
    expression: {fileID: 0}
    text: "Eh... tapi itu folder keuangan. \nAku baru hari pertama, aku belum tahu
      prosedurnya."
    voiceClip: {fileID: 8300000, guid: 57731bef768643f0af81b106a36bf931, type: 3}
    femalePlayerVoiceClip: {fileID: 8300000, guid: 38549b581e3ef9c4ca520a5626c9ad6c, type: 3}
  - speaker: 1
    mood: 0
    expression: {fileID: 0}
    text: "Lho, IT Support kan punya akses ke semua folder. \nCepet aja, 5 menit.
      Ini urgent buat direktur."
    voiceClip: {fileID: 8300000, guid: d8210994f1c94802878ffbdfd85eec56, type: 3}
    femalePlayerVoiceClip: {fileID: 0}
  - speaker: 0
    mood: 0
    expression: {fileID: 0}
    text: "(Tunggu. Orang ini tahu kamu IT Support tapi baru \nketemu kamu barusan.
      Dan minta file keuangan... lewat lift?)"
    voiceClip: {fileID: 8300000, guid: 77a658100e304c58ae43a3867a59616b, type: 3}
    femalePlayerVoiceClip: {fileID: 8300000, guid: c9825ae40c8fe824c83dcdcca11ecea8, type: 3}
  - speaker: 1
    mood: 0
    expression: {fileID: 0}
    text: "Jangan lama-lama mikir. \nDirektur lagi nunggu ini."
    voiceClip: {fileID: 8300000, guid: db5c07028c1641c58af9a512d0409174, type: 3}
    femalePlayerVoiceClip: {fileID: 0}
  hasChoice: 0
  acceptText: Oke, aku usahakan...
  rejectText: Maaf, aku tidak bisa.
  dialogueIfAccepted: {fileID: 0}
  dialogueIfRejected: {fileID: 0}
  actionID: VN_Receptionist_Topic1
