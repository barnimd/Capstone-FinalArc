  phishingURLs:
  - contextId: google_lookalike
    riskIndicatorIds:
    - lookalike_domain
    - credential_form
    url: https://go0gle.com/login
    siteName: Google
    isPhishing: 1
    explanation: Domain go0gle.com mengganti huruf o dengan angka 0 dan bukan domain resmi Google.
  - contextId: microsoft_missing_tld
    riskIndicatorIds:
    - missing_https
    - malformed_domain
    - misspelled_path
    url: http://microsoft/logn
    siteName: Microsoft
    isPhishing: 1
    explanation: Alamat tidak memakai HTTPS, tidak memiliki domain resmi Microsoft, dan path login salah eja.
  - contextId: secure_bank_deceptive_subdomain
    riskIndicatorIds:
    - missing_https
    - deceptive_subdomain
    - unrelated_domain
    url: http://secure-bank.tk.com
    siteName: Bank
    isPhishing: 1
    explanation: Nama secure-bank hanya subdomain; domain utamanya adalah tk.com dan bukan domain bank resmi.
  - contextId: paypal_lookalike
    riskIndicatorIds:
    - missing_https
    - lookalike_domain
    url: http://paypa1.com
    siteName: Paypa1
    isPhishing: 1
    explanation: Domain paypa1.com memakai angka 1 untuk meniru huruf l pada nama PayPal dan tidak memakai HTTPS.
  - contextId: facebook_lookalike
    riskIndicatorIds:
    - missing_https
    - lookalike_domain
    url: http://faceb00k.com
    siteName: Faceb00k
    isPhishing: 1
    explanation: Domain faceb00k.com memakai angka 0 untuk meniru huruf o dan tidak memakai HTTPS.
