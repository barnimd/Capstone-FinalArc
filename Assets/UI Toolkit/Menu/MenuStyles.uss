/* ============================================================
   SecMind Main Menu — UI Toolkit shell + page styles
   Palette: bg-deep #1A1612 · bg-card #2A2419 · bg-elevated #3A3328
            bone #F0E6D2 · ember #E87826 · ash #6B5D52
   ============================================================ */

/* ── Override default Unity theme borders/backgrounds ────── */

ScrollView,
.unity-scroll-view,
.unity-scroll-view__viewport,
.unity-scroll-view__content-viewport,
.unity-scroll-view__content-container {
    background-color: transparent;
    border-width: 0;
    border-color: transparent;
}

.unity-scroller,
.unity-scroller__slider,
.unity-base-slider__tracker,
.unity-base-slider__dragger {
    border-width: 0;
}

Button:focus,
.unity-button:focus {
    border-color: transparent;
    border-width: 0;
}

Button {
    border-width: 0;
}

/* ── Root layout ──────────────────────────────────────────── */

.menu-root {
    flex-grow: 1;
    flex-direction: row;
    background-color: rgb(20, 17, 14);
}

/* ── Sidebar ──────────────────────────────────────────────── */

.sidebar {
    width: 280px;
    background-color: rgb(20, 17, 14);
    padding: 24px 16px;
    flex-direction: column;
}

.sidebar-logo {
    height: 120px;
    -unity-background-scale-mode: scale-to-fit;
    background-image: url("project://database/Assets/Asset%20game/Icon/Secmind%20white.png");
    margin-bottom: 32px;
}

.sidebar-btn {
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    background-color: rgb(42, 36, 25);
    color: rgb(240, 230, 210);
    border-radius: 14px;
    padding: 14px 20px;
    margin-bottom: 10px;
    border-width: 0;
    transition-property: background-color, color;
    transition-duration: 0.15s;
}

.sidebar-btn-label {
    color: rgb(240, 230, 210);
    -unity-font-style: bold;
    font-size: 14px;
    letter-spacing: 0.5px;
    margin-left: 4px;
}

.sidebar-btn.active .sidebar-btn-label {
    color: rgb(240, 230, 210);
}

.sidebar-btn:hover {
    background-color: rgb(58, 51, 40);
}

.sidebar-btn.active {
    background-color: rgb(232, 120, 38);
    color: rgb(240, 230, 210);
}

.sidebar-btn-icon {
    width: 20px;
    height: 20px;
    margin-right: 16px;
    background-color: rgb(107, 93, 82);
    border-radius: 4px;
    flex-shrink: 0;
}

.sidebar-btn.active .sidebar-btn-icon {
    background-color: rgb(240, 230, 210);
}

.sidebar-spacer {
    flex-grow: 1;
}

.sidebar-btn-secondary {
    background-color: rgb(50, 26, 22);
}

.sidebar-btn-secondary:hover {
    background-color: rgb(70, 38, 32);
}

/* ── Main area (navbar + content) ────────────────────────── */

.main-area {
    flex-grow: 1;
    flex-direction: column;
    background-color: rgb(20, 17, 14);
}

.navbar {
    height: 90px;
    padding: 0 40px;
    flex-direction: row;
    align-items: center;
    background-color: rgb(20, 17, 14);
}

.navbar-greeting {
    font-size: 28px;
    color: rgb(240, 230, 210);
    -unity-font-style: bold;
    flex-grow: 1;
}

.navbar-profile {
    width: 48px;
    height: 48px;
    border-radius: 24px;
    background-color: rgb(232, 120, 38);
    align-items: center;
    justify-content: center;
}

.navbar-profile-text {
    color: rgb(240, 230, 210);
    -unity-font-style: bold;
    font-size: 18px;
}

/* ── Content container & pages ───────────────────────────── */

.content {
    flex-grow: 1;
    padding: 24px 40px 40px 40px;
    background-color: rgb(20, 17, 14);
}

.page {
    flex-grow: 1;
}

.page.hidden {
    display: none;
}

/* Placeholder for not-yet-migrated pages */
.page-placeholder {
    align-items: center;
    justify-content: center;
    flex-grow: 1;
}

.page-placeholder-text {
    color: rgb(107, 93, 82);
    font-size: 14px;
}

/* ── Leaderboard page (was: standalone .page) ────────────── */

.lb-page {
    flex-grow: 1;
    background-color: rgb(26, 22, 18);
    border-radius: 24px;
    padding: 32px 40px;
}

.lb-header {
    margin-bottom: 20px;
}

.label-eyebrow {
    font-size: 11px;
    color: rgb(107, 93, 82);
    letter-spacing: 2px;
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.title {
    font-size: 32px;
    color: rgb(240, 230, 210);
    -unity-font-style: bold;
}

.stat-strip {
    flex-direction: row;
    margin-bottom: 20px;
}

.stat-card {
    flex-grow: 1;
    background-color: rgb(42, 36, 25);
    border-radius: 16px;
    padding: 16px 20px;
    margin-right: 16px;
}

.stat-card-last { margin-right: 0; }

.stat-label {
    font-size: 11px;
    color: rgb(107, 93, 82);
    letter-spacing: 1.5px;
    -unity-font-style: bold;
    margin-bottom: 6px;
}

.stat-value {
    font-size: 28px;
    color: rgb(240, 230, 210);
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.stat-subtitle {
    font-size: 12px;
    color: rgb(107, 93, 82);
}

.filter-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 14px;
}

.filter-tab {
    background-color: rgb(42, 36, 25);
    color: rgb(107, 93, 82);
    border-radius: 22px;
    padding: 8px 18px;
    margin-right: 8px;
    -unity-font-style: bold;
    font-size: 12px;
    border-width: 0;
}

.filter-tab:hover {
    background-color: rgb(58, 51, 40);
    color: rgb(240, 230, 210);
}

.filter-tab.active {
    background-color: rgb(232, 120, 38);
    color: rgb(240, 230, 210);
}

.table-header {
    flex-direction: row;
    padding: 12px 24px;
    margin-bottom: 4px;
}

.col-header {
    font-size: 11px;
    color: rgb(107, 93, 82);
    letter-spacing: 1.5px;
    -unity-font-style: bold;
}

.col-rank { width: 60px; }
.col-player { flex-grow: 2; flex-basis: 0; }
.col-topic { flex-grow: 3; flex-basis: 0; }
.col-score { width: 80px; -unity-text-align: middle-right; }

.row-list { flex-grow: 1; }

.row {
    flex-direction: row;
    align-items: center;
    background-color: rgb(42, 36, 25);
    border-radius: 12px;
    padding: 12px 24px;
    margin-bottom: 8px;
    border-left-width: 0;
    border-left-color: rgb(232, 120, 38);
}

.row.you { border-left-width: 4px; }

.row:hover { background-color: rgb(58, 51, 40); }

.rank-badge {
    width: 32px;
    height: 32px;
    border-radius: 8px;
    background-color: rgb(58, 51, 40);
    align-items: center;
    justify-content: center;
}

.rank-badge.first { background-color: rgb(232, 120, 38); }

.rank-badge-text {
    color: rgb(240, 230, 210);
    -unity-font-style: bold;
    font-size: 13px;
}

.player-cell {
    flex-direction: row;
    align-items: center;
    flex-grow: 2;
    flex-basis: 0;
    margin-left: 28px;
}

.avatar {
    width: 32px;
    height: 32px;
    border-radius: 16px;
    background-color: rgb(58, 51, 40);
    align-items: center;
    justify-content: center;
    margin-right: 12px;
}

.avatar-text {
    color: rgb(240, 230, 210);
    -unity-font-style: bold;
    font-size: 12px;
}

.player-name {
    color: rgb(240, 230, 210);
    font-size: 14px;
}

.you-badge {
    background-color: rgb(232, 120, 38);
    color: rgb(240, 230, 210);
    font-size: 9px;
    -unity-font-style: bold;
    padding: 2px 6px;
    border-radius: 4px;
    margin-left: 10px;
    letter-spacing: 1px;
}

.topic-text {
    color: rgb(107, 93, 82);
    font-size: 13px;
    flex-grow: 3;
    flex-basis: 0;
}

.score-text {
    color: rgb(240, 230, 210);
    font-size: 16px;
    -unity-font-style: bold;
    width: 80px;
    -unity-text-align: middle-right;
}

.empty-state {
    align-items: center;
    justify-content: center;
    padding: 48px;
}

.empty-text {
    color: rgb(107, 93, 82);
    font-size: 14px;
}

/* ── Class page ──────────────────────────────────────────── */

.class-page {
    flex-grow: 1;
    background-color: rgb(26, 22, 18);
    border-radius: 24px;
    padding: 32px 40px;
}

.class-header {
    margin-bottom: 20px;
}

.class-scroll {
    flex-grow: 1;
}

.section-title {
    color: rgb(107, 93, 82);
    -unity-font-style: bold;
    font-size: 12px;
    letter-spacing: 2px;
    margin-top: 12px;
    margin-bottom: 14px;
}

.lesson-grid {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 8px;
}

.lesson-card {
    width: 180px;
    height: 220px;
    background-color: rgb(42, 36, 25);
    border-radius: 16px;
    padding: 16px;
    margin-right: 16px;
    margin-bottom: 16px;
    align-items: stretch;
    flex-direction: column;
    transition-property: background-color, scale;
    transition-duration: 0.15s;
}

.lesson-card:hover {
    background-color: rgb(58, 51, 40);
}

.lesson-card.locked {
    background-color: rgb(35, 30, 22);
}

.lesson-number {
    color: rgb(232, 120, 38);
    -unity-font-style: bold;
    font-size: 26px;
    margin-bottom: 4px;
}

.lesson-card.locked .lesson-number {
    color: rgb(107, 93, 82);
}

.lesson-icon {
    width: 80px;
    height: 80px;
    align-self: center;
    margin: 8px 0;
    -unity-background-scale-mode: scale-to-fit;
    background-color: rgba(0,0,0,0);
}

.lesson-title {
    color: rgb(240, 230, 210);
    font-size: 13px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
    margin-top: 6px;
}

.lesson-card.locked .lesson-title {
    color: rgb(107, 93, 82);
}

.lock-badge {
    position: absolute;
    top: 12px;
    right: 12px;
    width: 28px;
    height: 28px;
    border-radius: 14px;
    background-color: rgb(58, 51, 40);
    align-items: center;
    justify-content: center;
}

.lock-badge-text {
    color: rgb(240, 230, 210);
    font-size: 12px;
    -unity-font-style: bold;
}

/* ── Profile page ────────────────────────────────────────── */

.profile-page {
    flex-grow: 1;
    background-color: rgb(26, 22, 18);
    border-radius: 24px;
    padding: 32px 40px;
}

.profile-header {
    margin-bottom: 24px;
}

.profile-identity {
    flex-direction: row;
    align-items: center;
    padding-bottom: 24px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(58, 51, 40);
}

.profile-avatar {
    width: 84px;
    height: 84px;
    border-radius: 42px;
    background-color: rgb(232, 120, 38);
    align-items: center;
    justify-content: center;
    margin-right: 20px;
}

.profile-avatar-text {
    color: rgb(240, 230, 210);
    font-size: 36px;
    -unity-font-style: bold;
}

.profile-identity-text {
    flex-grow: 1;
    flex-direction: column;
}

.profile-name {
    color: rgb(240, 230, 210);
    -unity-font-style: bold;
    font-size: 28px;
    margin-top: 2px;
}

.profile-meta {
    color: rgb(107, 93, 82);
    font-size: 12px;
    margin-top: 4px;
}

.profile-edit-btn {
    background-color: rgb(42, 36, 25);
    color: rgb(240, 230, 210);
    border-radius: 12px;
    padding: 10px 16px;
    border-width: 0;
}

.profile-edit-btn:hover {
    background-color: rgb(58, 51, 40);
}

.profile-edit-btn-label {
    color: rgb(240, 230, 210);
    font-size: 12px;
    -unity-font-style: bold;
}

.profile-stats {
    flex-direction: row;
    padding: 24px 0;
    border-bottom-width: 1px;
    border-bottom-color: rgb(58, 51, 40);
}

.profile-stat-card {
    flex-grow: 1;
    flex-basis: 0;
    padding: 0 24px;
    border-right-width: 1px;
    border-right-color: rgb(58, 51, 40);
}

.profile-stat-card-last {
    border-right-width: 0;
}

.profile-progress-row {
    flex-direction: row;
    margin-top: 28px;
}

.profile-progress-col {
    flex-grow: 1;
    flex-basis: 0;
    padding-right: 32px;
}

.progress-section-title {
    color: rgb(240, 230, 210);
    -unity-font-style: bold;
    font-size: 14px;
    margin-bottom: 16px;
}

.progress-list {
    flex-direction: column;
}

.progress-item {
    margin-bottom: 14px;
}

.progress-item-header {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 6px;
}

.progress-item-name {
    color: rgb(240, 230, 210);
    font-size: 12px;
    flex-grow: 1;
}

.progress-item-percent {
    color: rgb(232, 120, 38);
    font-size: 12px;
    -unity-font-style: bold;
}

.progress-bar-bg {
    height: 3px;
    background-color: rgb(58, 51, 40);
    border-radius: 2px;
    overflow: hidden;
}

.progress-bar-fill {
    height: 3px;
    background-color: rgb(232, 120, 38);
    border-radius: 2px;
}

/* ── Dashboard page ──────────────────────────────────────── */

.dashboard-page {
    flex-grow: 1;
    background-color: rgb(26, 22, 18);
    border-radius: 24px;
    padding: 32px 40px;
}

.dashboard-header {
    margin-bottom: 20px;
}

.slideshow-frame {
    flex-grow: 1;
    border-radius: 16px;
    overflow: hidden;
    background-color: rgb(20, 17, 14);
}

.slideshow-image {
    flex-grow: 1;
    -unity-background-scale-mode: scale-to-fit;
    background-color: rgb(20, 17, 14);
}

.slideshow-arrow {
    position: absolute;
    width: 48px;
    height: 48px;
    border-radius: 24px;
    background-color: rgba(26, 22, 18, 0.75);
    color: rgb(240, 230, 210);
    border-width: 0;
    align-items: center;
    justify-content: center;
    top: 50%;
    margin-top: -24px;
}

.slideshow-arrow:hover {
    background-color: rgba(232, 120, 38, 0.85);
}

.slideshow-arrow-left {
    left: 20px;
}

.slideshow-arrow-right {
    right: 20px;
}

.slideshow-arrow-text {
    color: rgb(240, 230, 210);
    font-size: 28px;
    -unity-font-style: bold;
}

.slideshow-dots {
    position: absolute;
    bottom: 16px;
    left: 0;
    right: 0;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.slideshow-dot {
    width: 8px;
    height: 8px;
    border-radius: 4px;
    background-color: rgba(240, 230, 210, 0.4);
    margin: 0 4px;
}

.slideshow-dot.active {
    background-color: rgb(232, 120, 38);
    width: 24px;
}

/* ── Get Help page ───────────────────────────────────────── */

.help-page {
    flex-grow: 1;
    background-color: rgb(26, 22, 18);
    border-radius: 24px;
    padding: 32px 40px;
}

.help-header {
    margin-bottom: 20px;
}

.help-section-eyebrow {
    color: rgb(107, 93, 82);
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    margin-top: 8px;
    margin-bottom: 14px;
}

/* Search */

.help-search-row {
    flex-direction: row;
    align-items: center;
    background-color: rgb(42, 36, 25);
    border-radius: 16px;
    padding: 6px;
    margin-bottom: 24px;
}

.help-search { flex-grow: 1; }

.help-search > .unity-base-text-field__input {
    background-color: rgba(0,0,0,0);
    color: rgb(240, 230, 210);
    border-width: 0;
    padding: 10px 16px;
    font-size: 13px;
}

.help-search-btn {
    background-color: rgb(232, 120, 38);
    color: rgb(240, 230, 210);
    border-radius: 12px;
    padding: 10px 24px;
    -unity-font-style: bold;
    font-size: 13px;
}

.help-search-btn:hover { background-color: rgb(212, 100, 28); }

/* Topic cards */

.help-topics-row {
    flex-direction: row;
    margin-bottom: 28px;
}

.help-topic-card {
    flex-grow: 1;
    flex-basis: 0;
    background-color: rgb(240, 230, 210);
    border-radius: 16px;
    padding: 20px;
    margin-right: 16px;
    align-items: flex-start;
    flex-direction: column;
    border-width: 0;
}

.help-topic-card:hover {
    background-color: rgb(220, 210, 190);
}

.help-topics-row > .help-topic-card:last-child { margin-right: 0; }

.help-topic-icon-box {
    width: 40px;
    height: 40px;
    border-radius: 10px;
    background-color: rgb(232, 120, 38);
    align-items: center;
    justify-content: center;
    margin-bottom: 16px;
}

.help-topic-icon {
    font-size: 16px;
    color: rgb(240, 230, 210);
    -unity-text-align: middle-center;
    width: 40px;
    height: 40px;
}

.help-topic-title {
    color: rgb(30, 22, 18);
    font-size: 15px;
    -unity-font-style: bold;
    margin-bottom: 6px;
}

.help-topic-desc {
    color: rgb(107, 93, 82);
    font-size: 12px;
    white-space: normal;
    margin-bottom: 14px;
}

.help-topic-open {
    color: rgb(232, 120, 38);
    font-size: 12px;
    -unity-font-style: bold;
}

/* Bottom row: FAQ + Still Stuck */

.help-bottom-row {
    flex-direction: row;
}

.help-faq-col {
    flex-grow: 2;
    flex-basis: 0;
    margin-right: 24px;
}

.help-faq-list {
    flex-direction: column;
}

.help-faq-item {
    background-color: rgb(42, 36, 25);
    border-radius: 12px;
    padding: 14px 18px;
    margin-bottom: 8px;
}

.help-faq-item:hover {
    background-color: rgb(50, 43, 32);
}

.help-faq-question {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.help-faq-q-text {
    color: rgb(240, 230, 210);
    font-size: 13px;
    -unity-font-style: bold;
    flex-grow: 1;
    white-space: normal;
}

.help-faq-chevron {
    color: rgb(107, 93, 82);
    font-size: 14px;
    margin-left: 8px;
    rotate: 0deg;
    transition-property: rotate;
    transition-duration: 0.15s;
}

.help-faq-item.expanded .help-faq-chevron {
    rotate: 180deg;
    color: rgb(232, 120, 38);
}

.help-faq-answer {
    color: rgb(180, 165, 150);
    font-size: 12px;
    white-space: normal;
    margin-top: 8px;
    display: none;
}

.help-faq-item.expanded .help-faq-answer {
    display: flex;
}

/* Still Stuck */

.help-stuck-col {
    flex-grow: 1;
    flex-basis: 0;
}

.help-stuck-card {
    background-color: rgb(240, 230, 210);
    border-radius: 16px;
    padding: 20px;
}

.help-stuck-title {
    color: rgb(30, 22, 18);
    font-size: 15px;
    -unity-font-style: bold;
    white-space: normal;
    margin-bottom: 8px;
}

.help-stuck-desc {
    color: rgb(107, 93, 82);
    font-size: 12px;
    white-space: normal;
    margin-bottom: 16px;
}

.help-stuck-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 12px;
}

.help-stuck-icon-box {
    width: 36px;
    height: 36px;
    border-radius: 10px;
    background-color: rgb(232, 120, 38);
    align-items: center;
    justify-content: center;
    margin-right: 12px;
}

.help-stuck-icon {
    font-size: 14px;
    color: rgb(240, 230, 210);
    -unity-text-align: middle-center;
    width: 36px;
    height: 36px;
}

.help-stuck-text-block { flex-direction: column; }

.help-stuck-label {
    color: rgb(107, 93, 82);
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 0.5px;
}

.help-stuck-value {
    color: rgb(30, 22, 18);
    font-size: 13px;
    -unity-font-style: bold;
}

.help-contact-btn {
    background-color: rgb(30, 22, 18);
    color: rgb(240, 230, 210);
    border-radius: 12px;
    padding: 14px;
    -unity-font-style: bold;
    font-size: 13px;
    margin-top: 12px;
    -unity-text-align: middle-center;
}

.help-contact-btn:hover { background-color: rgb(50, 42, 36); }

/* ── Coming Soon modal ───────────────────────────────────── */

.modal-backdrop {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background-color: rgba(0, 0, 0, 0.7);
    align-items: center;
    justify-content: center;
}

.modal-backdrop.hidden {
    display: none;
}

.modal-card {
    width: 360px;
    background-color: rgb(42, 36, 25);
    border-radius: 16px;
    padding: 28px 24px;
    align-items: center;
}

.modal-title {
    color: rgb(232, 120, 38);
    font-size: 22px;
    -unity-font-style: bold;
    margin-bottom: 12px;
}

.modal-desc {
    color: rgb(180, 165, 150);
    font-size: 13px;
    -unity-text-align: middle-center;
    white-space: normal;
    margin-bottom: 22px;
}

.modal-button {
    background-color: rgb(232, 120, 38);
    color: rgb(240, 230, 210);
    border-radius: 12px;
    padding: 10px 36px;
    -unity-font-style: bold;
    font-size: 13px;
}

.modal-button:hover { background-color: rgb(212, 100, 28); }
