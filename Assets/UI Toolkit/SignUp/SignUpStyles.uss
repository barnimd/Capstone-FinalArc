/* ============================================================
   SecMind SignUp — UI Toolkit styles
   Palette: Midnight Cocoa #1E1612 · Bone #F0E6D2 · Ember #E87826 · Ash #6B5D52
   ============================================================ */

/* ── Overrides ───────────────────────────────────────────── */

ScrollView, .unity-scroll-view, .unity-scroll-view__viewport, .unity-scroll-view__content-viewport {
    background-color: transparent;
    border-width: 0;
}

Button:focus, .unity-button:focus {
    border-color: transparent;
    border-width: 0;
}

Button { border-width: 0; }

/* ── Root layout ─────────────────────────────────────────── */

.signup-root {
    flex-grow: 1;
    flex-direction: column;
    background-color: rgb(30, 22, 18);
}

.signup-topbar {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 32px 60px 0 60px;
}

.signup-body {
    flex-grow: 1;
    flex-direction: row;
}

.signup-footer {
    color: rgb(107, 93, 82);
    font-size: 11px;
    -unity-text-align: middle-center;
    padding: 20px 0;
}

/* ── Top bar ─────────────────────────────────────────────── */

.brand {
    color: rgb(240, 230, 210);
    font-size: 18px;
    -unity-font-style: bold;
    letter-spacing: 3px;
}

.topbar-help {
    flex-direction: row;
    align-items: center;
}

.topbar-help-text {
    color: rgb(107, 93, 82);
    font-size: 13px;
    margin-right: 6px;
}

.topbar-help-link {
    color: rgb(232, 120, 38);
    font-size: 13px;
    -unity-font-style: bold;
}

/* ── Hero panel ──────────────────────────────────────────── */

.hero-panel {
    flex-grow: 1;
    flex-basis: 0;
    padding: 32px 60px;
    justify-content: center;
}

.hero-content { max-width: 540px; }

.hero-eyebrow {
    color: rgb(232, 120, 38);
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 3px;
    margin-bottom: 20px;
}

.hero-title {
    color: rgb(240, 230, 210);
    font-size: 56px;
    -unity-font-style: bold;
    white-space: normal;
}

.hero-title-accent { color: rgb(232, 120, 38); }

.feature-list { margin-top: 36px; }

.feature-item {
    flex-direction: row;
    align-items: flex-start;
    margin-bottom: 20px;
}

.feature-check {
    width: 28px;
    height: 28px;
    border-radius: 8px;
    background-color: rgb(232, 120, 38);
    align-items: center;
    justify-content: center;
    margin-right: 16px;
    flex-shrink: 0;
}

.feature-check-text {
    color: rgb(240, 230, 210);
    -unity-font-style: bold;
    font-size: 18px;
    -unity-text-align: middle-center;
    padding: 0;
    margin: 0;
    width: 28px;
    height: 28px;
}

.feature-text-block { flex-direction: column; }

.feature-title {
    color: rgb(240, 230, 210);
    -unity-font-style: bold;
    font-size: 14px;
}

.feature-subtitle {
    color: rgb(107, 93, 82);
    font-size: 12px;
    margin-top: 2px;
}

/* ── SignUp card ─────────────────────────────────────────── */

.signup-panel {
    flex-grow: 1;
    flex-basis: 0;
    align-items: center;
    justify-content: center;
    padding: 32px;
}

.signup-card {
    width: 440px;
    background-color: rgb(20, 14, 12);
    border-radius: 24px;
    padding: 32px 32px 28px 32px;
    border-width: 1px;
    border-color: rgb(45, 35, 30);
}

.signup-logo {
    height: 70px;
    -unity-background-scale-mode: scale-to-fit;
    background-image: url("project://database/Assets/Asset%20game/Icon/Secmind%20white.png");
}

.signup-eyebrow {
    color: rgb(107, 93, 82);
    font-size: 11px;
    letter-spacing: 3px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 20px;
    margin-top: 4px;
}

.field-label {
    color: rgb(107, 93, 82);
    font-size: 11px;
    letter-spacing: 1.5px;
    -unity-font-style: bold;
    margin-bottom: 6px;
    margin-top: 10px;
}

.input { background-color: rgb(42, 30, 25); border-radius: 12px; border-width: 0; }

.input > .unity-base-text-field__input {
    background-color: rgb(42, 30, 25);
    color: rgb(240, 230, 210);
    border-radius: 12px;
    padding: 12px 16px;
    border-width: 0;
    font-size: 14px;
}

.input:focus > .unity-base-text-field__input,
.input > .unity-base-text-field__input:focus {
    border-width: 1px;
    border-color: rgb(232, 120, 38);
}

/* ── Password strength meter ─────────────────────────────── */

.strength-meter {
    flex-direction: row;
    margin-top: 8px;
    height: 4px;
}

.strength-segment {
    flex-grow: 1;
    flex-basis: 0;
    background-color: rgb(58, 51, 40);
    margin-right: 4px;
    border-radius: 2px;
}

.strength-segment-last { margin-right: 0; }

/* Filled colors by level */
.strength-segment.filled-weak   { background-color: rgb(220, 80, 60); }
.strength-segment.filled-medium { background-color: rgb(220, 160, 40); }
.strength-segment.filled-strong { background-color: rgb(232, 120, 38); }
.strength-segment.filled-super  { background-color: rgb(80, 200, 100); }

.strength-label {
    font-size: 11px;
    margin-top: 6px;
    -unity-font-style: bold;
}

.strength-label.weak   { color: rgb(220, 80, 60); }
.strength-label.medium { color: rgb(220, 160, 40); }
.strength-label.strong { color: rgb(232, 120, 38); }
.strength-label.super  { color: rgb(80, 200, 100); }
.strength-label.none   { color: rgb(107, 93, 82); }

/* ── Terms checkbox ──────────────────────────────────────── */

.terms-row {
    flex-direction: row;
    align-items: center;
    margin-top: 14px;
    margin-bottom: 14px;
}

.terms-checkbox > .unity-toggle__input { margin-right: 6px; }
.terms-checkbox Label {
    color: rgb(180, 165, 150);
    font-size: 12px;
}

.terms-link {
    color: rgb(232, 120, 38);
    font-size: 12px;
    -unity-font-style: bold;
}

/* ── Buttons ─────────────────────────────────────────────── */

.button-primary {
    background-color: rgb(232, 120, 38);
    color: rgb(240, 230, 210);
    border-radius: 14px;
    padding: 14px;
    -unity-font-style: bold;
    font-size: 14px;
    margin-bottom: 12px;
    -unity-text-align: middle-center;
}

.button-primary:hover { background-color: rgb(212, 100, 28); }

.divider {
    flex-direction: row;
    align-items: center;
    margin: 4px 0 12px 0;
}

.divider-line {
    flex-grow: 1;
    height: 1px;
    background-color: rgb(58, 51, 40);
}

.divider-text {
    color: rgb(107, 93, 82);
    font-size: 11px;
    margin: 0 12px;
    letter-spacing: 2px;
    -unity-font-style: bold;
}

.button-google {
    background-color: rgb(240, 230, 210);
    border-radius: 14px;
    padding: 14px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.button-google:hover { background-color: rgb(220, 210, 190); }

.google-icon {
    width: 18px;
    height: 18px;
    margin-right: 10px;
    -unity-background-scale-mode: scale-to-fit;
    /* TODO: replace with actual google logo PNG, e.g.: */
    /* background-image: url("project://database/Assets/Asset%20game/Icon/google_logo.png"); */
    background-color: rgb(66, 133, 244);
    border-radius: 9px;
}

.google-label {
    color: rgb(30, 22, 18);
    -unity-font-style: bold;
    font-size: 14px;
}

/* ── Error ───────────────────────────────────────────────── */

.error {
    color: rgb(255, 100, 80);
    font-size: 12px;
    -unity-text-align: middle-center;
    margin-top: 10px;
    display: none;
}

.error.visible { display: flex; }
