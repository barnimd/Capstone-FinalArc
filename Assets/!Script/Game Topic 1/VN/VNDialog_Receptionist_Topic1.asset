  m_Name: VNDialog_Receptionist_Topic1
  m_EditorClassIdentifier: 
  playerName: Kamu
  npcName: Kak Rani
  playerPortrait: {fileID: 21300000, guid: 91753b50188160e469f1596dd7b4e6be, type: 3}
  playerTalkingPortrait: {fileID: 21300000, guid: 6f7b85b4da78fd74eb50431daa554c0f, type: 3}
  playerThinkingPortrait: {fileID: 0}
  playerSmilingPortrait: {fileID: 0}
  npc2Name: 
  npcPortrait: {fileID: 21300000, guid: db561ec6e2c62ca4d97523d8036c50a1, type: 3}
  npcTalkingPortrait: {fileID: 21300000, guid: 5c65e9eda00eafd4295869a651231baa, type: 3}
  npcThinkingPortrait: {fileID: 0}
  npcSmilingPortrait: {fileID: 0}
  npc2Portrait: {fileID: 0}
  npc2TalkingPortrait: {fileID: 0}
  npc2ThinkingPortrait: {fileID: 0}
  npc2SmilingPortrait: {fileID: 0}
  background: {fileID: 21300000, guid: 226c45f7d559b5c4585666cf850d72f9, type: 3}
  lines:
  - speaker: 1
    mood: 1
    expression: {fileID: 0}
    text: "Hei! Kamu yang anak IT Support magang baru ya? \nAku Rani, resepsionis
      di sini."
    voiceClip: {fileID: 8300000, guid: 6f24b5c0cd097874f8bc3d5d7464665b, type: 3}
  - speaker: 0
    mood: 1
    expression: {fileID: 0}
    text: "Iya Kak, Ini hari pertama saya... \nmasih agak grogi hehe."
    voiceClip: {fileID: 8300000, guid: c97ae823a6902d146affdfdf0a830b74, type: 3}
  - speaker: 1
    mood: 0
    expression: {fileID: 0}
    text: "Santai saja. Meja kamu di paling kanan ruangan cubicle, setelah cubicle
      nya Pak Budi. \nBadge ID-nya sudah diterima dari HRD?"
    voiceClip: {fileID: 8300000, guid: e9a1227d1b480f344b04193105be8c8e, type: 3}
  - speaker: 0
    mood: 0
    expression: {fileID: 0}
    text: Em... saya belum dapat badge Kak.
    voiceClip: {fileID: 8300000, guid: 49f5e5c2480541f459896a38af863a08, type: 3}
  - speaker: 1
    mood: 1
    expression: {fileID: 0}
    text: "Coba cek email, harusnya ada instruksi dari HRD pagi ini. \nKalau belum
      masuk, kemungkinan besok baru dapat, bisa langsung ke ruangan sebelah."
    voiceClip: {fileID: 8300000, guid: e3b59b5816b253341af2050600c90f16, type: 3}
  - speaker: 1
    mood: 1
    expression: {fileID: 0}
    text: "Oh iya ada kejadian kemarin yang perlu kamu tahu. \nSeseorang masuk dan
      ngaku sebagai teknisi IT dari vendor."
    voiceClip: {fileID: 8300000, guid: d4e17d8143509bf4b9c728c84c4b67d3, type: 3}
  - speaker: 0
    mood: 1
    expression: {fileID: 0}
    text: Terus?
    voiceClip: {fileID: 8300000, guid: d57befb3d0a319b4586f786a6b17af5e, type: 3}
  - speaker: 1
    mood: 1
    expression: {fileID: 0}
    text: "Minta akses ke komputer Pak Hendra di Finance. \nUntung Pak Hendra curiga
      dan lapor dulu ke Security."
    voiceClip: {fileID: 8300000, guid: 474f8bd75751d084cb04b89cea716970, type: 3}
  - speaker: 1
    mood: 1
    expression: {fileID: 0}
    text: "Hari-hari ini harus hati-hati. Siapapun yang minta akses \natau minta
      file \u2014 verifikasi dulu lewat jalur resmi, ya."
    voiceClip: {fileID: 8300000, guid: d81c1d380c4cd7a4ea19a6e16bba9fad, type: 3}
  - speaker: 0
    mood: 1
    expression: {fileID: 0}
    text: Siap Kak, makasih infonya!
    voiceClip: {fileID: 8300000, guid: 54e8fec01f03850478947b62c3a331d6, type: 3}
  - speaker: 1
    mood: 1
    expression: {fileID: 0}
    text: Semangat hari pertamanya! Jangan segan tanya kalau bingung.
    voiceClip: {fileID: 8300000, guid: e2981112b1dd9e14bbf6092674075ee0, type: 3}
  hasChoice: 0
  acceptText: Ya
  rejectText: Tidak
  dialogueIfAccepted: {fileID: 0}
  dialogueIfRejected: {fileID: 0}
  actionID: VN_Receptionist_Topic1
