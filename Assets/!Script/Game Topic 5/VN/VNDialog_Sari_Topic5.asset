  lines:
  - speaker: 1
    mood: 3
    expression: {fileID: 0}
    text: Selamat datang di CafeBean! Mau pesan apa?
    voiceClip: {fileID: 0}
  - speaker: 0
    mood: 0
    expression: {fileID: 0}
    text: Hei, satu americano ya. Oh iya, nama Wi-Fi-nya apa?
    voiceClip: {fileID: 0}
  - speaker: 1
    mood: 0
    expression: {fileID: 0}
    text: Wi-Fi kita namanya CafeBean_Free, password-nya ada di papan kecil dekat
      tanaman di pojok. Kalau ada yang aneh, langsung bilang ke kami ya!
    voiceClip: {fileID: 0}
  - speaker: 0
    mood: 3
    expression: {fileID: 0}
    text: Oke, makasih!
    voiceClip: {fileID: 0}
  - speaker: 2
    mood: 0
    expression: {fileID: 0}
    text: Raka melihat sekeliling. Kafe cukup ramai. Beberapa orang sibuk dengan
      laptop masing-masing.
    voiceClip: {fileID: 0}
