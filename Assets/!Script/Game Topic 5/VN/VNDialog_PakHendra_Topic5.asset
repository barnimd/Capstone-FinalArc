  npcTalkingPortrait: {fileID: 21300000, guid: b6529a954a0d07f44935fa59e90116e2, type: 3}
  npcThinkingPortrait: {fileID: 0}
  npcSmilingPortrait: {fileID: 0}
  npc2Portrait: {fileID: 0}
