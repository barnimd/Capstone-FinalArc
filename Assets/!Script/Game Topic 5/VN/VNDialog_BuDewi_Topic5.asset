  background: {fileID: 21300000, guid: 8a0f3582c534d8e47a6118304da619ee, type: 3}
  lines:
  - speaker: 1
    mood: 0
    expression: {fileID: 0}
    text: Ruangan ini sudah dipesan untuk meeting.
    voiceClip: {fileID: 8300000, guid: 46d36520d4a574044a58ef5257e220b5, type: 3}
  - speaker: 0
    mood: 0
    expression: {fileID: 0}
    text: Maaf Bu, sebentar saja. Saya mau kasih tahu, ada Wi-Fi palsu di gedung
      ini. Namanya mirip punya kafe.
    voiceClip: {fileID: 8300000, guid: 66f1063623f34f549abf3a3d689ce4a0, type: 3}
  - speaker: 1
    mood: 2
    expression: {fileID: 0}
    text: Wi-Fi palsu? Saya baru connect ke CafeBean_Free_5G. Ini salah?
    voiceClip: {fileID: 8300000, guid: 5038d1e3d54d7c040821132e725ada8f, type: 3}
  - speaker: 0
    mood: 0
    expression: {fileID: 0}
    text: Ya Bu. Itu bukan jaringan kafe. Segera disconnect dan ganti ke CafeBean_Free
      yang terproteksi.
    voiceClip: {fileID: 8300000, guid: 7df69abcf714c2846a5e2bb71c711ef2, type: 3}
  - speaker: 1
    mood: 0
    expression: {fileID: 0}
    text: Astaga. Saya baru kirim dokumen kontrak tadi. Kalau sampai bocor...
    voiceClip: {fileID: 8300000, guid: 11054b6dee41c49459f630e49726d22d, type: 3}
  - speaker: 0
    mood: 0
    expression: {fileID: 0}
    text: Semoga belum sempat disadap. Setelah ini ganti password email dan cek aktivitas
      login yang mencurigakan.
    voiceClip: {fileID: 8300000, guid: be2d3084b3e5f0745a886abdd6d84196, type: 3}
  - speaker: 1
    mood: 0
    expression: {fileID: 0}
    text: Terima kasih banyak. Tolong laporkan orang itu.
    voiceClip: {fileID: 8300000, guid: 9e4434dff563b304292e43508113edd2, type: 3}
  hasChoice: 0
  acceptText: Ya
  rejectText: Tidak
