/* ============================================================
   SecMind Main Menu — UI Toolkit shell + page styles
   Palette: bg-deep #1A1612 · bg-card #2A2419 · bg-elevated #3A3328
            bone #F0E6D2 · ember #E87826
            muted-on-dark rgb(180,166,150) · muted-dim rgb(148,133,120)
            muted-on-bone rgb(82,68,58) · ember-on-bone rgb(178,82,12)
   ============================================================ */

/* ── Override default Unity theme borders/backgrounds ────── */

ScrollView,
.unity-scroll-view,
.unity-scroll-view__viewport,
.unity-scroll-view__content-viewport,
.unity-scroll-view__content-container {
    background-color: transparent;
    border-width: 0;
    border-color: transparent;
}

.unity-scroller,
.unity-scroller__slider,
.unity-base-slider__tracker,
.unity-base-slider__dragger {
    border-width: 0;
}

Button:focus,
.unity-button:focus {
    border-color: transparent;
    border-width: 0;
}

Button {
    border-width: 0;
}

/* ── Root layout ──────────────────────────────────────────── */

.menu-root {
    flex-grow: 1;
    flex-direction: row;
    background-color: rgb(20, 17, 14);
}

/* ── Sidebar ──────────────────────────────────────────────── */

.sidebar {
    width: 296px;
    background-color: rgb(20, 17, 14);
    padding: 24px 16px;
    flex-direction: column;
}

.sidebar-logo {
    height: 120px;
    -unity-background-scale-mode: scale-to-fit;
    background-image: url("project://database/Assets/Asset%20game/Icon/Secmind%20white.png");
    margin-bottom: 32px;
}

.sidebar-btn {
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    background-color: rgb(42, 36, 25);
    color: rgb(248, 242, 230);
    border-radius: 14px;
    padding: 15px 20px;
    margin-bottom: 10px;
    border-width: 0;
    transition-property: background-color, color;
    transition-duration: 0.15s;
}

.sidebar-btn-label {
    color: rgb(248, 242, 230);
    -unity-font-style: bold;
    font-size: 17px;
    letter-spacing: 0.5px;
    margin-left: 4px;
}

.sidebar-btn.active .sidebar-btn-label {
    color: rgb(255, 252, 245);
}

.sidebar-btn:hover {
    background-color: rgb(58, 51, 40);
}

.sidebar-btn.active {
    background-color: rgb(232, 120, 38);
    color: rgb(255, 252, 245);
}

.sidebar-btn-icon {
    width: 22px;
    height: 22px;
    margin-right: 16px;
    background-color: rgb(180, 166, 150);
    border-radius: 4px;
    flex-shrink: 0;
}

.sidebar-btn.active .sidebar-btn-icon {
    background-color: rgb(255, 252, 245);
}

.sidebar-spacer {
    flex-grow: 1;
}

.sidebar-btn-secondary {
    background-color: rgb(50, 26, 22);
}

.sidebar-btn-secondary:hover {
    background-color: rgb(70, 38, 32);
}

/* ── Main area (navbar + content) ────────────────────────── */

.main-area {
    flex-grow: 1;
    flex-direction: column;
    background-color: rgb(20, 17, 14);
}

.navbar {
    height: 96px;
    padding: 0 40px;
    flex-direction: row;
    align-items: center;
    background-color: rgb(20, 17, 14);
}

.navbar-greeting {
    font-size: 34px;
    color: rgb(248, 242, 230);
    -unity-font-style: bold;
    flex-grow: 1;
}

.navbar-profile {
    width: 52px;
    height: 52px;
    border-radius: 26px;
    background-color: rgb(232, 120, 38);
    align-items: center;
    justify-content: center;
}

.navbar-profile-text {
    color: rgb(255, 252, 245);
    -unity-font-style: bold;
    font-size: 22px;
}

/* ── Content container & pages ───────────────────────────── */

.content {
    flex-grow: 1;
    padding: 24px 40px 40px 40px;
    background-color: rgb(20, 17, 14);
}

.page {
    flex-grow: 1;
}

.page.hidden {
    display: none;
}

/* Placeholder for not-yet-migrated pages */
.page-placeholder {
    align-items: center;
    justify-content: center;
    flex-grow: 1;
}

.page-placeholder-text {
    color: rgb(180, 166, 150);
    font-size: 17px;
}

/* ── Leaderboard page (was: standalone .page) ────────────── */

.lb-page {
    flex-grow: 1;
    background-color: rgb(26, 22, 18);
    border-radius: 24px;
    padding: 32px 40px;
}

.lb-header {
    margin-bottom: 20px;
}

.label-eyebrow {
    font-size: 14px;
    color: rgb(196, 182, 166);
    letter-spacing: 2px;
    -unity-font-style: bold;
    margin-bottom: 6px;
}

.title {
    font-size: 40px;
    color: rgb(248, 242, 230);
    -unity-font-style: bold;
}

.stat-strip {
    flex-direction: row;
    margin-bottom: 20px;
}

.stat-card {
    flex-grow: 1;
    background-color: rgb(42, 36, 25);
    border-radius: 16px;
    padding: 18px 22px;
    margin-right: 16px;
}

.stat-card-last { margin-right: 0; }

.stat-label {
    font-size: 13px;
    color: rgb(196, 182, 166);
    letter-spacing: 1.5px;
    -unity-font-style: bold;
    margin-bottom: 6px;
}

.stat-value {
    font-size: 34px;
    color: rgb(248, 242, 230);
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.stat-subtitle {
    font-size: 14px;
    color: rgb(180, 166, 150);
}

.filter-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 14px;
}

.filter-tab {
    background-color: rgb(42, 36, 25);
    color: rgb(196, 182, 166);
    border-radius: 22px;
    padding: 9px 20px;
    margin-right: 8px;
    -unity-font-style: bold;
    font-size: 14px;
    border-width: 0;
}

.filter-tab:hover {
    background-color: rgb(58, 51, 40);
    color: rgb(248, 242, 230);
}

.filter-tab.active {
    background-color: rgb(232, 120, 38);
    color: rgb(255, 252, 245);
}

.table-header {
    flex-direction: row;
    padding: 12px 24px;
    margin-bottom: 4px;
}

.col-header {
    font-size: 13px;
    color: rgb(196, 182, 166);
    letter-spacing: 1.5px;
    -unity-font-style: bold;
}

.col-rank { width: 66px; }
.col-player { flex-grow: 2; flex-basis: 0; }
.col-topic { flex-grow: 3; flex-basis: 0; }
.col-score { width: 94px; -unity-text-align: middle-right; }

.row-list { flex-grow: 1; }

.row {
    flex-direction: row;
    align-items: center;
    background-color: rgb(42, 36, 25);
    border-radius: 12px;
    padding: 13px 24px;
    margin-bottom: 8px;
    border-left-width: 0;
    border-left-color: rgb(232, 120, 38);
}

.row.you { border-left-width: 4px; }

.row:hover { background-color: rgb(58, 51, 40); }

.rank-badge {
    width: 36px;
    height: 36px;
    border-radius: 8px;
    background-color: rgb(58, 51, 40);
    align-items: center;
    justify-content: center;
}

.rank-badge.first { background-color: rgb(232, 120, 38); }

.rank-badge-text {
    color: rgb(248, 242, 230);
    -unity-font-style: bold;
    font-size: 16px;
}

.player-cell {
    flex-direction: row;
    align-items: center;
    flex-grow: 2;
    flex-basis: 0;
    margin-left: 28px;
}

.avatar {
    width: 36px;
    height: 36px;
    border-radius: 18px;
    background-color: rgb(58, 51, 40);
    align-items: center;
    justify-content: center;
    margin-right: 12px;
}

.avatar-text {
    color: rgb(248, 242, 230);
    -unity-font-style: bold;
    font-size: 14px;
}

.player-name {
    color: rgb(248, 242, 230);
    font-size: 17px;
}

.you-badge {
    background-color: rgb(232, 120, 38);
    color: rgb(255, 252, 245);
    font-size: 11px;
    -unity-font-style: bold;
    padding: 3px 7px;
    border-radius: 4px;
    margin-left: 10px;
    letter-spacing: 1px;
}

.topic-text {
    color: rgb(188, 174, 158);
    font-size: 15px;
    flex-grow: 3;
    flex-basis: 0;
}

.score-text {
    color: rgb(248, 242, 230);
    font-size: 19px;
    -unity-font-style: bold;
    width: 94px;
    -unity-text-align: middle-right;
}

.empty-state {
    align-items: center;
    justify-content: center;
    padding: 48px;
}

.empty-text {
    color: rgb(180, 166, 150);
    font-size: 17px;
}

/* ── Class page ──────────────────────────────────────────── */

.class-page {
    flex-grow: 1;
    background-color: rgb(26, 22, 18);
    border-radius: 24px;
    padding: 32px 40px;
}

.class-header {
    margin-bottom: 20px;
}

.class-scroll {
    flex-grow: 1;
}

.section-title {
    color: rgb(196, 182, 166);
    -unity-font-style: bold;
    font-size: 15px;
    letter-spacing: 2px;
    margin-top: 12px;
    margin-bottom: 14px;
}

.lesson-grid {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 8px;
}

.lesson-card {
    width: 200px;
    height: 248px;
    background-color: rgb(42, 36, 25);
    border-radius: 16px;
    padding: 16px;
    margin-right: 16px;
    margin-bottom: 16px;
    align-items: stretch;
    flex-direction: column;
    transition-property: background-color, scale;
    transition-duration: 0.15s;
}

.lesson-card:hover {
    background-color: rgb(58, 51, 40);
}

.lesson-card.locked {
    background-color: rgb(35, 30, 22);
}

.lesson-number {
    color: rgb(240, 132, 48);
    -unity-font-style: bold;
    font-size: 30px;
    margin-bottom: 4px;
}

.lesson-card.locked .lesson-number {
    color: rgb(148, 133, 120);
}

.lesson-icon {
    width: 84px;
    height: 84px;
    align-self: center;
    margin: 8px 0;
    -unity-background-scale-mode: scale-to-fit;
    background-color: rgba(0,0,0,0);
}

.lesson-title {
    color: rgb(248, 242, 230);
    font-size: 16px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
    margin-top: 6px;
}

.lesson-card.locked .lesson-title {
    color: rgb(160, 146, 132);
}

.lock-badge {
    position: absolute;
    top: 12px;
    right: 12px;
    width: 30px;
    height: 30px;
    border-radius: 15px;
    background-color: rgb(58, 51, 40);
    align-items: center;
    justify-content: center;
}

.lock-badge-text {
    color: rgb(248, 242, 230);
    font-size: 14px;
    -unity-font-style: bold;
}

/* ── Profile page ────────────────────────────────────────── */

.profile-page {
    flex-grow: 1;
    background-color: rgb(26, 22, 18);
    border-radius: 24px;
    padding: 32px 40px;
}

.profile-header {
    margin-bottom: 24px;
}

.profile-identity {
    flex-direction: row;
    align-items: center;
    padding-bottom: 24px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(58, 51, 40);
}

.profile-avatar {
    width: 90px;
    height: 90px;
    border-radius: 45px;
    background-color: rgb(232, 120, 38);
    align-items: center;
    justify-content: center;
    margin-right: 20px;
}

.profile-avatar-text {
    color: rgb(255, 252, 245);
    font-size: 40px;
    -unity-font-style: bold;
}

.profile-identity-text {
    flex-grow: 1;
    flex-direction: column;
}

.profile-name {
    color: rgb(248, 242, 230);
    -unity-font-style: bold;
    font-size: 34px;
    margin-top: 2px;
}

.profile-meta {
    color: rgb(180, 166, 150);
    font-size: 15px;
    margin-top: 5px;
}

.profile-edit-btn {
    background-color: rgb(42, 36, 25);
    color: rgb(248, 242, 230);
    border-radius: 12px;
    padding: 11px 18px;
    border-width: 0;
}

.profile-edit-btn:hover {
    background-color: rgb(58, 51, 40);
}

.profile-edit-btn-label {
    color: rgb(248, 242, 230);
    font-size: 14px;
    -unity-font-style: bold;
}

.profile-stats {
    flex-direction: row;
    padding: 24px 0;
    border-bottom-width: 1px;
    border-bottom-color: rgb(58, 51, 40);
}

.profile-stat-card {
    flex-grow: 1;
    flex-basis: 0;
    padding: 0 24px;
    border-right-width: 1px;
    border-right-color: rgb(58, 51, 40);
}

.profile-stat-card-last {
    border-right-width: 0;
}

.profile-progress-row {
    flex-direction: row;
    margin-top: 28px;
}

.profile-progress-col {
    flex-grow: 1;
    flex-basis: 0;
    padding-right: 32px;
}

.progress-section-title {
    color: rgb(248, 242, 230);
    -unity-font-style: bold;
    font-size: 17px;
    margin-bottom: 16px;
}

.progress-list {
    flex-direction: column;
}

.progress-item {
    margin-bottom: 14px;
}

.progress-item-header {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 6px;
}

.progress-item-name {
    color: rgb(248, 242, 230);
    font-size: 15px;
    flex-grow: 1;
}

.progress-item-percent {
    color: rgb(240, 132, 48);
    font-size: 15px;
    -unity-font-style: bold;
}

.progress-bar-bg {
    height: 5px;
    background-color: rgb(58, 51, 40);
    border-radius: 3px;
    overflow: hidden;
}

.progress-bar-fill {
    height: 5px;
    background-color: rgb(232, 120, 38);
    border-radius: 3px;
}

/* ── Dashboard page ──────────────────────────────────────── */

.dashboard-page {
    flex-grow: 1;
    background-color: rgb(26, 22, 18);
    border-radius: 24px;
    padding: 32px 40px;
}

.dashboard-header {
    margin-bottom: 20px;
}

.slideshow-frame {
    flex-grow: 1;
    border-radius: 16px;
    overflow: hidden;
    background-color: rgb(20, 17, 14);
}

.slideshow-image {
    flex-grow: 1;
    -unity-background-scale-mode: scale-to-fit;
    background-color: rgb(20, 17, 14);
}

.slideshow-arrow {
    position: absolute;
    width: 52px;
    height: 52px;
    border-radius: 26px;
    background-color: rgba(26, 22, 18, 0.8);
    color: rgb(248, 242, 230);
    border-width: 0;
    align-items: center;
    justify-content: center;
    top: 50%;
    margin-top: -26px;
}

.slideshow-arrow:hover {
    background-color: rgba(232, 120, 38, 0.9);
}

.slideshow-arrow-left {
    left: 20px;
}

.slideshow-arrow-right {
    right: 20px;
}

.slideshow-arrow-text {
    color: rgb(248, 242, 230);
    font-size: 32px;
    -unity-font-style: bold;
}

.slideshow-dots {
    position: absolute;
    bottom: 16px;
    left: 0;
    right: 0;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.slideshow-dot {
    width: 9px;
    height: 9px;
    border-radius: 5px;
    background-color: rgba(248, 242, 230, 0.5);
    margin: 0 4px;
}

.slideshow-dot.active {
    background-color: rgb(232, 120, 38);
    width: 26px;
}

/* ── Get Help page ───────────────────────────────────────── */

.help-page {
    flex-grow: 1;
    background-color: rgb(26, 22, 18);
    border-radius: 24px;
    padding: 32px 40px;
}

.help-header {
    margin-bottom: 20px;
}

.help-section-eyebrow {
    color: rgb(196, 182, 166);
    font-size: 14px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    margin-top: 8px;
    margin-bottom: 14px;
}

/* Search */

.help-search-row {
    flex-direction: row;
    align-items: center;
    background-color: rgb(42, 36, 25);
    border-radius: 16px;
    padding: 6px;
    margin-bottom: 24px;
}

.help-search { flex-grow: 1; }

.help-search > .unity-base-text-field__input {
    background-color: rgba(0,0,0,0);
    color: rgb(248, 242, 230);
    border-width: 0;
    padding: 11px 16px;
    font-size: 16px;
}

.help-search-btn {
    background-color: rgb(232, 120, 38);
    color: rgb(255, 252, 245);
    border-radius: 12px;
    padding: 11px 26px;
    -unity-font-style: bold;
    font-size: 15px;
}

.help-search-btn:hover { background-color: rgb(212, 100, 28); }

/* Topic cards */

.help-topics-row {
    flex-direction: row;
    margin-bottom: 28px;
}

.help-topic-card {
    flex-grow: 1;
    flex-basis: 0;
    background-color: rgb(244, 236, 220);
    border-radius: 16px;
    padding: 20px;
    margin-right: 16px;
    align-items: flex-start;
    flex-direction: column;
    border-width: 0;
}

.help-topic-card:hover {
    background-color: rgb(224, 214, 194);
}

.help-topics-row > .help-topic-card:last-child { margin-right: 0; }

.help-topic-icon-box {
    width: 44px;
    height: 44px;
    border-radius: 10px;
    background-color: rgb(232, 120, 38);
    align-items: center;
    justify-content: center;
    margin-bottom: 16px;
}

.help-topic-icon {
    font-size: 18px;
    color: rgb(255, 252, 245);
    -unity-text-align: middle-center;
    width: 44px;
    height: 44px;
}

.help-topic-title {
    color: rgb(24, 18, 14);
    font-size: 18px;
    -unity-font-style: bold;
    margin-bottom: 6px;
}

.help-topic-desc {
    color: rgb(82, 68, 58);
    font-size: 14px;
    white-space: normal;
    margin-bottom: 14px;
}

.help-topic-open {
    color: rgb(178, 82, 12);
    font-size: 14px;
    -unity-font-style: bold;
}

/* Bottom row: FAQ + Still Stuck */

.help-bottom-row {
    flex-direction: row;
}

.help-faq-col {
    flex-grow: 2;
    flex-basis: 0;
    margin-right: 24px;
}

.help-faq-list {
    flex-direction: column;
}

.help-faq-item {
    background-color: rgb(42, 36, 25);
    border-radius: 12px;
    padding: 15px 18px;
    margin-bottom: 8px;
}

.help-faq-item:hover {
    background-color: rgb(50, 43, 32);
}

.help-faq-question {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.help-faq-q-text {
    color: rgb(248, 242, 230);
    font-size: 16px;
    -unity-font-style: bold;
    flex-grow: 1;
    white-space: normal;
}

.help-faq-chevron {
    color: rgb(196, 182, 166);
    font-size: 16px;
    margin-left: 8px;
    rotate: 0deg;
    transition-property: rotate;
    transition-duration: 0.15s;
}

.help-faq-item.expanded .help-faq-chevron {
    rotate: 180deg;
    color: rgb(240, 132, 48);
}

.help-faq-answer {
    color: rgb(206, 194, 180);
    font-size: 15px;
    white-space: normal;
    margin-top: 8px;
    display: none;
}

.help-faq-item.expanded .help-faq-answer {
    display: flex;
}

/* Still Stuck */

.help-stuck-col {
    flex-grow: 1;
    flex-basis: 0;
}

.help-stuck-card {
    background-color: rgb(244, 236, 220);
    border-radius: 16px;
    padding: 20px;
}

.help-stuck-title {
    color: rgb(24, 18, 14);
    font-size: 18px;
    -unity-font-style: bold;
    white-space: normal;
    margin-bottom: 8px;
}

.help-stuck-desc {
    color: rgb(82, 68, 58);
    font-size: 14px;
    white-space: normal;
    margin-bottom: 16px;
}

.help-stuck-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 12px;
}

.help-stuck-icon-box {
    width: 40px;
    height: 40px;
    border-radius: 10px;
    background-color: rgb(232, 120, 38);
    align-items: center;
    justify-content: center;
    margin-right: 12px;
}

.help-stuck-icon {
    font-size: 16px;
    color: rgb(255, 252, 245);
    -unity-text-align: middle-center;
    width: 40px;
    height: 40px;
}

.help-stuck-text-block { flex-direction: column; }

.help-stuck-label {
    color: rgb(90, 76, 66);
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 0.5px;
}

.help-stuck-value {
    color: rgb(24, 18, 14);
    font-size: 15px;
    -unity-font-style: bold;
}

.help-contact-btn {
    background-color: rgb(30, 22, 18);
    color: rgb(255, 252, 245);
    border-radius: 12px;
    padding: 15px;
    -unity-font-style: bold;
    font-size: 15px;
    margin-top: 12px;
    -unity-text-align: middle-center;
}

.help-contact-btn:hover { background-color: rgb(50, 42, 36); }

/* ── Coming Soon modal ───────────────────────────────────── */

.modal-backdrop {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background-color: rgba(0, 0, 0, 0.7);
    align-items: center;
    justify-content: center;
}

.modal-backdrop.hidden {
    display: none;
}

.modal-card {
    width: 400px;
    background-color: rgb(42, 36, 25);
    border-radius: 16px;
    padding: 28px 24px;
    align-items: center;
}

.modal-title {
    color: rgb(240, 132, 48);
    font-size: 26px;
    -unity-font-style: bold;
    margin-bottom: 12px;
}

.modal-desc {
    color: rgb(206, 194, 180);
    font-size: 15px;
    -unity-text-align: middle-center;
    white-space: normal;
    margin-bottom: 22px;
}

.modal-button {
    background-color: rgb(232, 120, 38);
    color: rgb(255, 252, 245);
    border-radius: 12px;
    padding: 11px 38px;
    -unity-font-style: bold;
    font-size: 15px;
}

.modal-button:hover { background-color: rgb(212, 100, 28); }

/* ── Menu Admin page ─────────────────────────────────────── */

/* Generic hide utility (used by admin sub-views) */
.hidden { display: none; }

/* Distinct tint for the admin sidebar button */
.sidebar-btn-admin { background-color: rgb(50, 40, 22); }
.sidebar-btn-admin:hover { background-color: rgb(70, 56, 30); }

.admin-page {
    flex-grow: 1;
    background-color: rgb(26, 22, 18);
    border-radius: 24px;
    padding: 32px 40px;
}

.admin-home { flex-grow: 1; }

.admin-header { margin-bottom: 24px; }

.admin-cards-row {
    flex-direction: row;
}

.admin-card {
    width: 320px;
    background-color: rgb(42, 36, 25);
    border-radius: 20px;
    padding: 28px;
    margin-right: 20px;
    align-items: flex-start;
    flex-direction: column;
    border-width: 0;
    transition-property: background-color;
    transition-duration: 0.15s;
}

.admin-card:hover { background-color: rgb(58, 51, 40); }

.admin-card-icon-box {
    width: 58px;
    height: 58px;
    border-radius: 14px;
    background-color: rgb(232, 120, 38);
    align-items: center;
    justify-content: center;
    margin-bottom: 18px;
}

/* [Manage User] DI-COMMENT — style emoji ikon kartu "Manage Users" (menu dihilangkan):
.admin-card-icon {
    font-size: 26px;
    color: rgb(255, 252, 245);
    -unity-text-align: middle-center;
    width: 58px;
    height: 58px;
}
*/

/* Manage Class icon: PNG yang di-set via code (MainMenuController.LoadManageClassIcon),
   dirender di tengah kotak oranye tanpa mengubah warna latar kotak. */
.admin-card-icon-image {
    width: 58px;
    height: 58px;
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
}

.admin-card-title {
    color: rgb(248, 242, 230);
    font-size: 23px;
    -unity-font-style: bold;
    margin-bottom: 8px;
}

.admin-card-desc {
    color: rgb(180, 166, 150);
    font-size: 15px;
    white-space: normal;
    margin-bottom: 18px;
}

.admin-card-open {
    color: rgb(240, 132, 48);
    font-size: 15px;
    -unity-font-style: bold;
}

.admin-subview { flex-grow: 1; }

.admin-back-btn {
    background-color: rgb(42, 36, 25);
    border-radius: 12px;
    padding: 9px 18px;
    margin-bottom: 16px;
    align-self: flex-start;
    border-width: 0;
}

.admin-back-btn:hover { background-color: rgb(58, 51, 40); }

.admin-back-label {
    color: rgb(248, 242, 230);
    font-size: 15px;
    -unity-font-style: bold;
}

/* [Manage User] DI-COMMENT — style placeholder "Coming soon" pada subview daftar user (menu dihilangkan):
.admin-placeholder {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    padding: 60px;
}

.admin-placeholder-text {
    color: rgb(180, 166, 150);
    font-size: 17px;
}
*/

/* Admin level card = class lesson card + a status pill at the bottom */
.admin-level-card { height: 282px; }

.admin-status-btn {
    border-radius: 10px;
    padding: 8px 0;
    margin-top: 10px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    font-size: 14px;
    border-width: 0;
    color: rgb(255, 252, 245);
}

/* ── Menu Admin > Kelola Poster ──────────────────────────────────────────── */

/* Emoji icon for admin cards that have no PNG in Resources/Icons. The older
   .admin-card-icon rule is commented out with the Manage Users block, so this
   stands on its own rather than reviving disabled code. */
.admin-card-icon-emoji {
    font-size: 26px;
    color: rgb(255, 252, 245);
    -unity-text-align: middle-center;
    width: 58px;
    height: 58px;
}

.poster-toolbar {
    flex-direction: row;
    align-items: center;
    margin-bottom: 18px;
}

.poster-upload-btn {
    background-color: rgb(232, 120, 38);
    color: rgb(255, 252, 245);
    border-radius: 12px;
    padding: 10px 22px;
    font-size: 15px;
    -unity-font-style: bold;
    border-width: 0;
    transition-property: background-color;
    transition-duration: 0.15s;
}

.poster-upload-btn:hover { background-color: rgb(240, 132, 48); }

.poster-upload-btn:disabled { opacity: 0.5; }

.poster-status {
    color: rgb(180, 166, 150);
    font-size: 14px;
    margin-left: 16px;
    white-space: normal;
    flex-shrink: 1;
}

.poster-status-error { color: rgb(232, 108, 96); }

.poster-list { flex-grow: 1; }

.poster-row {
    flex-direction: row;
    align-items: center;
    background-color: rgb(42, 36, 25);
    border-radius: 16px;
    padding: 12px 18px;
    margin-bottom: 12px;
}

.poster-order {
    color: rgb(180, 166, 150);
    font-size: 15px;
    -unity-font-style: bold;
    width: 34px;
}

/* 16:9 so the thumbnail matches the shape of the dashboard slideshow frame. */
.poster-thumb {
    width: 128px;
    height: 72px;
    border-radius: 10px;
    background-color: rgb(28, 24, 17);
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    margin-right: 18px;
}

.poster-title {
    color: rgb(248, 242, 230);
    font-size: 16px;
    flex-grow: 1;
    white-space: normal;
}

.poster-move-btn {
    background-color: rgb(58, 51, 40);
    color: rgb(248, 242, 230);
    border-radius: 10px;
    width: 40px;
    height: 36px;
    margin-left: 8px;
    font-size: 16px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    border-width: 0;
}

.poster-move-btn:hover { background-color: rgb(74, 65, 51); }

.poster-move-btn:disabled { opacity: 0.35; }

.poster-delete-btn {
    background-color: rgb(58, 51, 40);
    color: rgb(232, 108, 96);
    border-radius: 10px;
    height: 36px;
    padding: 0 14px;
    margin-left: 8px;
    font-size: 15px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    border-width: 0;
}

.poster-delete-btn:hover { background-color: rgb(74, 65, 51); }

/* Second state of the two-step delete — the button says "Hapus?" and only the
   next click actually deletes. Cheaper than a modal and just as hard to do by
   accident. */
.poster-delete-armed {
    background-color: rgb(160, 54, 46);
    color: rgb(255, 244, 242);
}

.poster-empty {
    color: rgb(180, 166, 150);
    font-size: 16px;
    -unity-text-align: middle-center;
    padding: 48px;
    white-space: normal;
}

.admin-status-unlocked { background-color: rgb(58, 51, 40); }
.admin-status-locked { background-color: rgb(178, 58, 44); }
.admin-status-btn:hover { background-color: rgb(232, 120, 38); }

/* ── Settings page ────────────────────────────────────────── */

.settings-page {
    flex-grow: 1;
    background-color: rgb(26, 22, 18);
    border-radius: 24px;
    padding: 32px 40px;
}

.settings-scroll {
    flex-grow: 1;
}

.settings-card {
    background-color: rgb(42, 36, 25);
    border-radius: 16px;
    padding: 20px 24px;
    margin-bottom: 8px;
}

.settings-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 7px 0;
}

.settings-row-text {
    flex-grow: 1;
    flex-shrink: 1;
    margin-right: 20px;
}

.settings-row-title {
    font-size: 18px;
    color: rgb(248, 242, 230);
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.settings-row-desc {
    font-size: 15px;
    color: rgb(180, 166, 150);
    white-space: normal;
}

.settings-value {
    font-size: 24px;
    color: rgb(240, 132, 48);
    -unity-font-style: bold;
    min-width: 74px;
    -unity-text-align: middle-right;
}

.settings-slider {
    margin-top: 10px;
    margin-bottom: 2px;
}

.settings-slider .unity-base-slider__tracker {
    background-color: rgb(26, 22, 18);
    border-width: 0;
    border-radius: 4px;
    height: 8px;
}

.settings-slider .unity-base-slider__dragger {
    background-color: rgb(232, 120, 38);
    border-width: 0;
    border-radius: 10px;
    width: 20px;
    height: 20px;
    margin-top: -6px;
}

.settings-scale-row {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 10px;
}

.settings-scale-end {
    font-size: 13px;
    color: rgb(180, 166, 150);
}

.settings-hint {
    font-size: 15px;
    color: rgb(180, 166, 150);
    white-space: normal;
}

.settings-divider {
    height: 1px;
    background-color: rgb(58, 51, 40);
    margin: 8px 0;
}

.settings-toggle {
    margin: 0;
}

.settings-toggle .unity-toggle__checkmark {
    width: 28px;
    height: 28px;
    border-radius: 8px;
    background-color: rgb(26, 22, 18);
    border-width: 2px;
    border-color: rgb(90, 80, 66);
    -unity-background-image-tint-color: rgb(232, 120, 38);
}

.settings-toggle:hover .unity-toggle__checkmark {
    border-color: rgb(232, 120, 38);
}

.settings-footer {
    flex-direction: column;
    align-items: flex-start;
    margin-top: 14px;
}

.settings-footer .filter-tab {
    margin-bottom: 10px;
}
