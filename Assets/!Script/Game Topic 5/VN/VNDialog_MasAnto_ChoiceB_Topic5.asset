  lines:
  - speaker: 0
    mood: 0
    expression: {fileID: 0}
    text: Matikan sekarang, atau saya panggil staff.
    voiceClip: {fileID: 8300000, guid: 8bbfc09c97b93c04fb78a6eedc94e389, type: 3}
  - speaker: 1
    mood: 0
    expression: {fileID: 0}
    text: Oke oke, aku matiin. Nggak ada yang rugi kan?
    voiceClip: {fileID: 8300000, guid: 1434ca11c79918d43b281ef50998fa97, type: 3}
  - speaker: 0
    mood: 0
    expression: {fileID: 0}
    text: Ada yang sudah kena. Kamu harus tanggung jawab.
    voiceClip: {fileID: 8300000, guid: 35016b79281b18d449d5c3c9d7141a9e, type: 3}
  - speaker: 2
    mood: 0
    expression: {fileID: 0}
    text: Mas Anto mematikan router, mengemas barangnya, lalu pergi. Wi-Fi palsu
      hilang dari daftar jaringan.
    voiceClip: {fileID: 0}
