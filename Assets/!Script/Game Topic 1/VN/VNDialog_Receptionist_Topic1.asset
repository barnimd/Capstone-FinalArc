  background: {fileID: 21300000, guid: 226c45f7d559b5c4585666cf850d72f9, type: 3}
  lines:
  - speaker: 1
    mood: 1
    expression: {fileID: 0}
    text: "Hei! Kamu yang anak IT Support magang baru ya? \nAku Rani, resepsionis
      di sini."
  - speaker: 0
    mood: 1
    expression: {fileID: 0}
    text: "Iya Kak, Ini hari pertama saya... \nmasih agak grogi hehe."
  - speaker: 1
    mood: 0
    expression: {fileID: 0}
    text: "Santai saja. Meja kamu di lantai 2, sebelah kiri tangga. \nBadge ID-nya
      sudah diterima dari HRD?"
  - speaker: 0
    mood: 0
    expression: {fileID: 0}
    text: Em... saya belum dapat badge Bu.
  - speaker: 1
    mood: 1
    expression: {fileID: 0}
    text: "Coba cek email, harusnya ada instruksi dari HRD pagi ini. \nKalau belum
      masuk, langsung ke lantai 3."
  - speaker: 1
    mood: 1
    expression: {fileID: 0}
    text: "Oh iya ada kejadian kemarin yang perlu kamu tahu. \nSeseorang masuk dan
      ngaku sebagai teknisi IT dari vendor."
  - speaker: 0
    mood: 1
    expression: {fileID: 0}
    text: Terus?
  - speaker: 1
    mood: 1
    expression: {fileID: 0}
    text: "Minta akses ke komputer Pak Hendra di Finance. \nUntung Pak Hendra curiga
      dan lapor dulu ke Security."
  - speaker: 1
    mood: 1
    expression: {fileID: 0}
    text: "Hari-hari ini harus hati-hati. Siapapun yang minta akses \natau minta
      file \u2014 verifikasi dulu lewat jalur resmi, ya."
  - speaker: 0
    mood: 1
    expression: {fileID: 0}
    text: Siap Kak, makasih infonya!
  - speaker: 1
    mood: 1
    expression: {fileID: 0}
    text: Semangat hari pertamanya! Jangan segan tanya kalau bingung.
  hasChoice: 0
  acceptText: Ya
  rejectText: Tidak
  dialogueIfAccepted: {fileID: 0}
  dialogueIfRejected: {fileID: 0}
