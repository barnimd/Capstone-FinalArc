  playerName: You
  npcName: Receptionist
  playerPortrait: {fileID: 21300000, guid: 8870194a7f0066148879ec5d32812b12, type: 3}
  npcPortrait: {fileID: 21300000, guid: 35420c023ff4f2f4095f5b7dc0e1e366, type: 3}
