  lines:
  - speaker: 1
    mood: 0
    expression: {fileID: 0}
    text: Oh hei. Mau karaoke juga? Aku lagi nunggu teman.
    voiceClip: {fileID: 8300000, guid: 1e4ef81654f812c47bf91b843d210125, type: 3}
  - speaker: 0
    mood: 0
    expression: {fileID: 0}
    text: Perangkat itu milik kamu?
    voiceClip: {fileID: 8300000, guid: 4975d2a579c40b442af7769c2d6a4c2a, type: 3}
  - speaker: 1
    mood: 0
    expression: {fileID: 0}
    text: Oh itu... hotspot pribadi aja. Buat sendiri.
    voiceClip: {fileID: 8300000, guid: 559afe732b058504c866bc2faff92226, type: 3}
  - speaker: 0
    mood: 0
    expression: {fileID: 0}
    text: Namanya FREE_CAFE_WIFI dan CafeBean_Free_5G?
    voiceClip: {fileID: 8300000, guid: eaeeab10ccd652a4cbfb9651fb421b73, type: 3}
  - speaker: 1
    mood: 2
    expression: {fileID: 0}
    text: Kamu dari mana tahu?
    voiceClip: {fileID: 8300000, guid: 5e25cb185d62d2a46816d04ee89ee752, type: 3}
  - speaker: 0
    mood: 0
    expression: {fileID: 0}
    text: Sudah ada yang jadi korban. Laptop mereka di-redirect ke halaman login
      palsu.
    voiceClip: {fileID: 8300000, guid: 409d2b70480366a46a9d30117944185d, type: 3}
  - speaker: 2
    mood: 0
    expression: {fileID: 0}
    text: Mas Anto terdiam. Sekarang Raka harus menentukan respons yang paling aman.
    voiceClip: {fileID: 0}
