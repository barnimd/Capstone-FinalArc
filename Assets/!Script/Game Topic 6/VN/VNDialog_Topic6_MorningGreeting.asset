  background: {fileID: 21300000, guid: 44f8aac438133024ba589a704d1def92, type: 3}
  lines:
  - speaker: 1
    mood: 3
    expression: {fileID: 0}
    text: Pagi! Baru sampai ya? Semoga hari ini lancar.
    voiceClip: {fileID: 8300000, guid: f85df7e4e4873ee4d81417f05e8befde, type: 3}
  - speaker: 0
    mood: 3
    expression: {fileID: 0}
    text: Pagi. Iya, saya mau mulai kerja di meja saya.
    voiceClip: {fileID: 8300000, guid: f5cf90832d4363546bac1d3cedab52d2, type: 3}
  - speaker: 1
    mood: 0
    expression: {fileID: 0}
    text: Sebelum mulai, coba sapa Rafi dulu. Dia dari tadi kelihatan agak panik
      soal file kerjaannya.
    voiceClip: {fileID: 8300000, guid: 85b81539056c14645bbbf7af2d69c3db, type: 3}
  - speaker: 0
    mood: 0
    expression: {fileID: 0}
    text: Baik, saya akan tanya sebentar sebelum ke meja.
    voiceClip: {fileID: 8300000, guid: 55472d613fa6dd3409cb145e034777ad, type: 3}
  hasChoice: 0
  acceptText: Ya
  rejectText: Tidak
