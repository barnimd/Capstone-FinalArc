  npcPortrait: {fileID: 21300000, guid: 73896fe4f27144945b5e3d3c555552d5, type: 3}
  npcTalkingPortrait: {fileID: 0}
  npcThinkingPortrait: {fileID: 0}
  npcSmilingPortrait: {fileID: 0}
  npc2Portrait: {fileID: 0}
  npc2TalkingPortrait: {fileID: 0}
  npc2ThinkingPortrait: {fileID: 0}
  npc2SmilingPortrait: {fileID: 0}
  background: {fileID: 21300000, guid: d42e18970fada554fa2e1a4a29563b7b, type: 3}
  lines:
  - speaker: 2
    mood: 0
    expression: {fileID: 0}
    text: "Kamu memasuki lift sendirian. \nSesaat kemudian, seseorang masuk \u2014
      tampak terburu-buru."
  - speaker: 1
    mood: 0
    expression: {fileID: 0}
    text: "Eh hei! Kamu yang anak IT Support baru kan? \nKebetulan banget ketemu
      di sini."
  - speaker: 0
    mood: 1
    expression: {fileID: 0}
    text: Eh, iya. Maaf, kita pernah ketemu?
  - speaker: 1
    mood: 1
    expression: {fileID: 0}
    text: "Aku Rizal, divisi Finance. \nLo pasti belum hapal muka semua orang haha."
  - speaker: 0
    mood: 0
    expression: {fileID: 0}
    text: "(Kamu sama sekali tidak ingat pernah melihat \norang ini di briefing hari
      ini.)"
  - speaker: 1
    mood: 0
    expression: {fileID: 0}
    text: "Dengerin, aku butuh bantuan urgent banget nih. \nBos aku minta laporan
      Q3 Finance sebelum jam 3."
  - speaker: 1
    mood: 0
    expression: {fileID: 0}
    text: "Sistem gue error, ga bisa akses foldernya sendiri. \nBisa kirimin file
      dari komputer lo? Folder Finance Q3."
  - speaker: 0
    mood: 0
    expression: {fileID: 0}
    text: "Eh... tapi itu folder keuangan. \nAku baru hari pertama, aku belum tahu
      prosedurnya."
  - speaker: 1
    mood: 0
    expression: {fileID: 0}
    text: "Lho, IT Support kan punya akses ke semua folder. \nCepet aja, 5 menit.
      Ini urgent buat direktur."
  - speaker: 0
    mood: 0
    expression: {fileID: 0}
    text: "(Tunggu. Orang ini tahu kamu IT Support tapi baru \nketemu kamu barusan.
      Dan minta file keuangan... lewat lift?)"
  - speaker: 1
    mood: 0
    expression: {fileID: 0}
    text: "Jangan lama-lama mikir. \nDirektur lagi nunggu ini."
  hasChoice: 1
  acceptText: Oke, aku usahakan...
  rejectText: Maaf, aku tidak bisa.
  dialogueIfAccepted: {fileID: 0}
  dialogueIfRejected: {fileID: 0}
  actionID: VN_Receptionist_Topic1
