  lines:
  - speaker: 0
    mood: 0
    expression: {fileID: 0}
    text: Kenapa kamu lakuin ini?
    voiceClip: {fileID: 8300000, guid: 1c72f71aab3abf14fb48eccac2383565, type: 3}
  - speaker: 1
    mood: 0
    expression: {fileID: 0}
    text: Iseng aja. Orang-orang terlalu gampang percaya Wi-Fi gratis.
    voiceClip: {fileID: 8300000, guid: 4a0d3ec18f9113f41b505b40be31ae08, type: 3}
  - speaker: 0
    mood: 0
    expression: {fileID: 0}
    text: Itu bukan iseng. Itu kejahatan siber.
    voiceClip: {fileID: 8300000, guid: 4d80bc76995310d439ddaa12ef70cb7d, type: 3}
  - speaker: 1
    mood: 2
    expression: {fileID: 0}
    text: ...
    voiceClip: {fileID: 0}
  - speaker: 0
    mood: 0
    expression: {fileID: 0}
    text: Matikan sekarang.
    voiceClip: {fileID: 8300000, guid: f3348191c0d9f3742a81ed5136897d74, type: 3}
  - speaker: 2
    mood: 0
    expression: {fileID: 0}
    text: Mas Anto mematikan router dan pergi. Tanpa laporan ke staff, tidak ada
      konsekuensi resmi.
    voiceClip: {fileID: 0}
