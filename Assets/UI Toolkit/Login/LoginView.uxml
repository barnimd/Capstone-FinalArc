<?xml version="1.0" encoding="utf-8"?>
<engine:UXML xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements">
    <engine:Style src="project://database/Assets/UI%20Toolkit/Login/LoginStyles.uss" />

    <engine:VisualElement class="login-root">

        <!-- ============ TOP BAR (full width) ============ -->
        <engine:VisualElement class="login-topbar">
            <engine:Label text="SECMIND." class="hero-brand" />
            <engine:VisualElement class="hero-help">
                <engine:Label text="Need help?" class="hero-help-text" />
                <engine:Label text="Contact support" class="hero-help-link" name="link-contact" />
            </engine:VisualElement>
        </engine:VisualElement>

        <!-- ============ BODY (2-col) ============ -->
        <engine:VisualElement class="login-body">

            <!-- LEFT: Hero -->
            <engine:VisualElement class="hero-panel">
                <engine:VisualElement class="hero-content">
                    <engine:Label text="WELCOME BACK" class="hero-eyebrow" />
                    <engine:Label text="Stay sharp." class="hero-title" />
                    <engine:VisualElement style="flex-direction: row;">
                        <engine:Label text="Stay " class="hero-title" />
                        <engine:Label text="secure." class="hero-title hero-title-accent" />
                    </engine:VisualElement>
                    <engine:Label text="Continue your training. Spot phishing, harden passwords, and keep your streak alive." class="hero-subtitle" />

                    <engine:VisualElement class="hero-stats">
                        <engine:VisualElement class="hero-stat">
                            <engine:Label text="6"        class="hero-stat-number" />
                            <engine:Label text="MODULES"  class="hero-stat-label" />
                        </engine:VisualElement>
                        <engine:VisualElement class="hero-stat">
                            <engine:Label text="184"      class="hero-stat-number" />
                            <engine:Label text="PLAYERS"  class="hero-stat-label" />
                        </engine:VisualElement>
                        <engine:VisualElement class="hero-stat">
                            <engine:Label text="4.9★"    class="hero-stat-number" />
                            <engine:Label text="RATING"   class="hero-stat-label" />
                        </engine:VisualElement>
                    </engine:VisualElement>
                </engine:VisualElement>
            </engine:VisualElement>

            <!-- RIGHT: Login card -->
            <engine:VisualElement class="login-panel">
                <engine:VisualElement class="login-card">
                    <engine:VisualElement class="login-logo" />
                    <engine:Label text="SIGN IN TO CONTINUE" class="login-eyebrow" />

                    <engine:Label text="NICKNAME" class="login-field-label" />
                    <engine:TextField name="nickname-input" class="login-input" />

                    <engine:Label text="PASSWORD" class="login-field-label" />
                    <engine:TextField name="password-input" class="login-input" password="true" />

                    <engine:VisualElement class="login-row">
                        <engine:Label text="Forgot password?" name="forgot-link" class="login-link" />
                    </engine:VisualElement>

                    <engine:Button text="OK, go!" name="login-button" class="login-button-primary" />

                    <engine:VisualElement class="login-divider">
                        <engine:VisualElement class="login-divider-line" />
                        <engine:Label text="OR" class="login-divider-text" />
                        <engine:VisualElement class="login-divider-line" />
                    </engine:VisualElement>

                    <engine:Button name="google-button" class="login-button-google">
                        <engine:VisualElement class="google-icon" />
                        <engine:Label text="Sign in with Google" class="google-label" />
                    </engine:Button>

                    <engine:VisualElement class="login-bottom">
                        <engine:Label text="New to this game?" class="login-bottom-text" />
                        <engine:Label text="Make an account" name="signup-link" class="login-link" />
                    </engine:VisualElement>

                    <engine:Label text="" name="login-error" class="login-error" />
                </engine:VisualElement>
            </engine:VisualElement>

        </engine:VisualElement>

        <!-- ============ FOOTER ============ -->
        <engine:Label text="© 2026 SecMind · Cyber Security Awareness Game" class="hero-footer" />
    </engine:VisualElement>
</engine:UXML>
