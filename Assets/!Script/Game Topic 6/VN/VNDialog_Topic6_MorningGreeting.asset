  lines:
  - speaker: 1
    mood: 3
    expression: {fileID: 0}
    text: Pagi! Baru sampai ya? Semoga hari ini lancar.
    voiceClip: {fileID: 0}
  - speaker: 0
    mood: 3
    expression: {fileID: 0}
    text: Pagi. Iya, saya mau mulai kerja di meja saya.
    voiceClip: {fileID: 0}
  - speaker: 1
    mood: 0
    expression: {fileID: 0}
    text: Sebelum mulai, coba sapa Rafi dulu. Dia dari tadi kelihatan agak panik
      soal file kerjaannya.
    voiceClip: {fileID: 0}
  - speaker: 0
    mood: 0
    expression: {fileID: 0}
    text: Baik, saya akan tanya sebentar sebelum ke meja.
    voiceClip: {fileID: 0}
