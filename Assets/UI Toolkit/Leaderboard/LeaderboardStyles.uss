/* ==========================================================================
   SecMind Leaderboard — UI Toolkit styles
   Palette: bg-deep #1A1612 · bg-card #2A2419 · bg-elevated #3A3328
            bone #F0E6D2 · ember #E87826 · ash #6B5D52
   ========================================================================== */

.page {
    position: absolute;
    left: 600px;
    top: 130px;
    right: 40px;
    bottom: 40px;
    padding: 32px 40px;
    background-color: rgb(26, 22, 18);
    border-radius: 24px;
}

/* ── Header ──────────────────────────────────────────────────────────── */

.page-header {
    margin-bottom: 24px;
}

.label-eyebrow {
    font-size: 11px;
    color: rgb(107, 93, 82);
    letter-spacing: 2px;
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.title {
    font-size: 32px;
    color: rgb(240, 230, 210);
    -unity-font-style: bold;
}

/* ── Stat strip ──────────────────────────────────────────────────────── */

.stat-strip {
    flex-direction: row;
    margin-bottom: 24px;
}

.stat-card {
    flex-grow: 1;
    background-color: rgb(42, 36, 25);
    border-radius: 16px;
    padding: 18px 20px;
    margin-right: 16px;
}

.stat-card-last {
    margin-right: 0;
}

.stat-label {
    font-size: 11px;
    color: rgb(107, 93, 82);
    letter-spacing: 1.5px;
    -unity-font-style: bold;
    margin-bottom: 6px;
}

.stat-value {
    font-size: 28px;
    color: rgb(240, 230, 210);
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.stat-subtitle {
    font-size: 12px;
    color: rgb(107, 93, 82);
}

/* ── Filter row ──────────────────────────────────────────────────────── */

.filter-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 16px;
}

.filter-tab {
    background-color: rgb(42, 36, 25);
    color: rgb(107, 93, 82);
    border-radius: 22px;
    padding: 8px 18px;
    margin-right: 8px;
    -unity-font-style: bold;
    font-size: 12px;
    border-width: 0;
}

.filter-tab:hover {
    background-color: rgb(58, 51, 40);
    color: rgb(240, 230, 210);
}

.filter-tab.active {
    background-color: rgb(232, 120, 38);
    color: rgb(240, 230, 210);
}

/* ── Table header ────────────────────────────────────────────────────── */

.table-header {
    flex-direction: row;
    padding: 12px 24px;
    margin-bottom: 4px;
}

.col-header {
    font-size: 11px;
    color: rgb(107, 93, 82);
    letter-spacing: 1.5px;
    -unity-font-style: bold;
}

.col-rank { width: 60px; }
.col-player { flex-grow: 2; flex-basis: 0; }
.col-topic { flex-grow: 3; flex-basis: 0; }
.col-score { width: 80px; -unity-text-align: middle-right; }

/* ── Row list + row ──────────────────────────────────────────────────── */

.row-list {
    flex-grow: 1;
}

.row {
    flex-direction: row;
    align-items: center;
    background-color: rgb(42, 36, 25);
    border-radius: 12px;
    padding: 12px 24px;
    margin-bottom: 8px;
    border-left-width: 0;
    border-left-color: rgb(232, 120, 38);
}

.row.you {
    border-left-width: 4px;
}

.row:hover {
    background-color: rgb(58, 51, 40);
}

.rank-badge {
    width: 32px;
    height: 32px;
    border-radius: 8px;
    background-color: rgb(58, 51, 40);
    align-items: center;
    justify-content: center;
}

.rank-badge.first {
    background-color: rgb(232, 120, 38);
}

.rank-badge-text {
    color: rgb(240, 230, 210);
    -unity-font-style: bold;
    font-size: 13px;
}

.player-cell {
    flex-direction: row;
    align-items: center;
    flex-grow: 2;
    flex-basis: 0;
    margin-left: 28px;
}

.avatar {
    width: 32px;
    height: 32px;
    border-radius: 16px;
    background-color: rgb(58, 51, 40);
    align-items: center;
    justify-content: center;
    margin-right: 12px;
}

.avatar-text {
    color: rgb(240, 230, 210);
    -unity-font-style: bold;
    font-size: 12px;
}

.player-name {
    color: rgb(240, 230, 210);
    font-size: 14px;
}

.you-badge {
    background-color: rgb(232, 120, 38);
    color: rgb(240, 230, 210);
    font-size: 9px;
    -unity-font-style: bold;
    padding: 2px 6px;
    border-radius: 4px;
    margin-left: 10px;
    letter-spacing: 1px;
}

.topic-text {
    color: rgb(107, 93, 82);
    font-size: 13px;
    flex-grow: 3;
    flex-basis: 0;
}

.score-text {
    color: rgb(240, 230, 210);
    font-size: 16px;
    -unity-font-style: bold;
    width: 80px;
    -unity-text-align: middle-right;
}

/* ── Empty state ─────────────────────────────────────────────────────── */

.empty-state {
    align-items: center;
    justify-content: center;
    padding: 48px;
}

.empty-text {
    color: rgb(107, 93, 82);
    font-size: 14px;
}
