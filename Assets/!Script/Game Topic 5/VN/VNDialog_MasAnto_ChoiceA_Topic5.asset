  lines:
  - speaker: 0
    mood: 0
    expression: {fileID: 0}
    text: Saya sudah panggil staff.
    voiceClip: {fileID: 0}
  - speaker: 1
    mood: 2
    expression: {fileID: 0}
    text: Eh tunggu, ini salah paham...
    voiceClip: {fileID: 0}
  - speaker: 2
    mood: 0
    expression: {fileID: 0}
    text: Pak Hendra masuk bersama security kafe.
    voiceClip: {fileID: 0}
  - speaker: 3
    mood: 0
    expression: {fileID: 0}
    text: Bapak harus ikut kami bicara dulu. Perangkat ini akan kami amankan.
    voiceClip: {fileID: 0}
  - speaker: 1
    mood: 0
    expression: {fileID: 0}
    text: Iya iya... aku matiin.
    voiceClip: {fileID: 0}
  - speaker: 2
    mood: 0
    expression: {fileID: 0}
    text: Router dimatikan. Semua jaringan palsu menghilang dari daftar.
