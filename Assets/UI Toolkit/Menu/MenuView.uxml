<?xml version="1.0" encoding="utf-8"?>
<engine:UXML xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements">
    <engine:Style src="project://database/Assets/UI%20Toolkit/Menu/MenuStyles.uss" />

    <engine:VisualElement class="menu-root">

        <!-- ============= SIDEBAR ============= -->
        <engine:VisualElement class="sidebar">
            <engine:VisualElement class="sidebar-logo" name="sidebar-logo" />

            <engine:Button name="btn-dashboard" class="sidebar-btn active">
                <engine:VisualElement class="sidebar-btn-icon" />
                <engine:Label text="Dashboard" class="sidebar-btn-label" />
            </engine:Button>
            <engine:Button name="btn-class" class="sidebar-btn">
                <engine:VisualElement class="sidebar-btn-icon" />
                <engine:Label text="Class" class="sidebar-btn-label" />
            </engine:Button>
            <engine:Button name="btn-profile" class="sidebar-btn">
                <engine:VisualElement class="sidebar-btn-icon" />
                <engine:Label text="Profile" class="sidebar-btn-label" />
            </engine:Button>
            <engine:Button name="btn-leaderboard" class="sidebar-btn">
                <engine:VisualElement class="sidebar-btn-icon" />
                <engine:Label text="Leaderboard" class="sidebar-btn-label" />
            </engine:Button>

            <engine:VisualElement class="sidebar-spacer" />

            <engine:Button name="btn-settings" class="sidebar-btn sidebar-btn-secondary">
                <engine:VisualElement class="sidebar-btn-icon" />
                <engine:Label text="Settings" class="sidebar-btn-label" />
            </engine:Button>
            <engine:Button name="btn-help" class="sidebar-btn sidebar-btn-secondary">
                <engine:VisualElement class="sidebar-btn-icon" />
                <engine:Label text="Get Help" class="sidebar-btn-label" />
            </engine:Button>
        </engine:VisualElement>

        <!-- ============= MAIN AREA ============= -->
        <engine:VisualElement class="main-area">

            <!-- Navbar -->
            <engine:VisualElement class="navbar">
                <engine:Label text="Hi, Player" name="navbar-greeting" class="navbar-greeting" />
                <engine:VisualElement class="navbar-profile">
                    <engine:Label text="?" name="navbar-profile-text" class="navbar-profile-text" />
                </engine:VisualElement>
            </engine:VisualElement>

            <!-- Content -->
            <engine:VisualElement class="content">

                <!-- Placeholder pages (fallback to uGUI for now) -->
                <engine:VisualElement name="page-dashboard" class="page dashboard-page">
                    <engine:VisualElement class="dashboard-header">
                        <engine:Label text="DASHBOARD" class="label-eyebrow" />
                        <engine:Label text="Welcome Back" class="title" />
                    </engine:VisualElement>

                    <engine:VisualElement class="slideshow-frame">
                        <engine:VisualElement name="slideshow-image" class="slideshow-image" />
                        <engine:Button name="slideshow-prev" class="slideshow-arrow slideshow-arrow-left">
                            <engine:Label text="‹" class="slideshow-arrow-text" />
                        </engine:Button>
                        <engine:Button name="slideshow-next" class="slideshow-arrow slideshow-arrow-right">
                            <engine:Label text="›" class="slideshow-arrow-text" />
                        </engine:Button>
                        <engine:VisualElement name="slideshow-dots" class="slideshow-dots" />
                    </engine:VisualElement>
                </engine:VisualElement>

                <engine:VisualElement name="page-class" class="page class-page hidden">
                    <engine:VisualElement class="class-header">
                        <engine:Label text="CLASSROOM" class="label-eyebrow" />
                        <engine:Label text="Lessons" class="title" />
                    </engine:VisualElement>
                    <engine:ScrollView class="class-scroll">
                        <engine:Label text="UNLOCKED" class="section-title" />
                        <engine:VisualElement name="unlocked-grid" class="lesson-grid" />
                        <engine:Label text="LOCKED" class="section-title" />
                        <engine:VisualElement name="locked-grid" class="lesson-grid" />
                    </engine:ScrollView>
                </engine:VisualElement>

                <engine:VisualElement name="page-profile" class="page profile-page hidden">
                    <engine:VisualElement class="profile-header">
                        <engine:Label text="PROFILE" class="label-eyebrow" />
                        <engine:Label text="Hi, Player" class="title" name="profile-greeting" />
                    </engine:VisualElement>

                    <engine:VisualElement class="profile-identity">
                        <engine:VisualElement class="profile-avatar">
                            <engine:Label text="P" class="profile-avatar-text" name="profile-avatar-text" />
                        </engine:VisualElement>
                        <engine:VisualElement class="profile-identity-text">
                            <engine:Label text="PLAYER" class="label-eyebrow" />
                            <engine:Label text="Player Name" class="profile-name" name="profile-name" />
                            <engine:Label text="Joined 2026 · Rank — globally" class="profile-meta" name="profile-meta" />
                        </engine:VisualElement>
                        <engine:Button class="profile-edit-btn" name="btn-edit-profile">
                            <engine:Label text="✎ Edit profile" class="profile-edit-btn-label" />
                        </engine:Button>
                    </engine:VisualElement>

                    <engine:VisualElement class="profile-stats">
                        <engine:VisualElement class="profile-stat-card">
                            <engine:Label text="LEVEL CLEARED" class="stat-label" />
                            <engine:Label text="— / 6" class="stat-value" name="profile-level-cleared" />
                        </engine:VisualElement>
                        <engine:VisualElement class="profile-stat-card">
                            <engine:Label text="ACHIEVEMENTS" class="stat-label" />
                            <engine:Label text="0" class="stat-value" name="profile-achievements" />
                        </engine:VisualElement>
                        <engine:VisualElement class="profile-stat-card">
                            <engine:Label text="PLAYTIME" class="stat-label" />
                            <engine:Label text="—" class="stat-value" name="profile-playtime" />
                        </engine:VisualElement>
                        <engine:VisualElement class="profile-stat-card profile-stat-card-last">
                            <engine:Label text="GLOBAL RANK" class="stat-label" />
                            <engine:Label text="—" class="stat-value" name="profile-rank" />
                        </engine:VisualElement>
                    </engine:VisualElement>

                    <engine:VisualElement class="profile-progress-row">
                        <engine:VisualElement class="profile-progress-col">
                            <engine:Label text="Course Progress" class="progress-section-title" />
                            <engine:VisualElement name="course-progress-list" class="progress-list" />
                        </engine:VisualElement>
                        <engine:VisualElement class="profile-progress-col">
                            <engine:Label text="Game Progress" class="progress-section-title" />
                            <engine:VisualElement name="game-progress-list" class="progress-list" />
                        </engine:VisualElement>
                    </engine:VisualElement>
                </engine:VisualElement>

                <!-- LEADERBOARD page (fully migrated) -->
                <engine:VisualElement name="page-leaderboard" class="page lb-page hidden">
                    <engine:VisualElement class="lb-header">
                        <engine:Label text="LEADERBOARD" class="label-eyebrow" />
                        <engine:Label text="Top Scores" class="title" />
                    </engine:VisualElement>

                    <engine:VisualElement class="stat-strip">
                        <engine:VisualElement class="stat-card" name="stat-your-rank">
                            <engine:Label text="YOUR RANK" class="stat-label" />
                            <engine:Label text="—" class="stat-value" name="your-rank-value" />
                            <engine:Label text="not yet ranked" class="stat-subtitle" name="your-rank-subtitle" />
                        </engine:VisualElement>
                        <engine:VisualElement class="stat-card" name="stat-your-best">
                            <engine:Label text="YOUR BEST" class="stat-label" />
                            <engine:Label text="—" class="stat-value" name="your-best-value" />
                            <engine:Label text="no completion yet" class="stat-subtitle" name="your-best-subtitle" />
                        </engine:VisualElement>
                        <engine:VisualElement class="stat-card stat-card-last" name="stat-top-score">
                            <engine:Label text="TOP SCORE" class="stat-label" />
                            <engine:Label text="—" class="stat-value" name="top-score-value" />
                            <engine:Label text="—" class="stat-subtitle" name="top-score-subtitle" />
                        </engine:VisualElement>
                    </engine:VisualElement>

                    <engine:VisualElement class="filter-row">
                        <engine:Button text="Global"    class="filter-tab active" name="tab-global" />
                        <engine:Button text="Friends"   class="filter-tab"        name="tab-friends" />
                        <engine:Button text="This Week" class="filter-tab"        name="tab-week" />
                    </engine:VisualElement>

                    <engine:VisualElement class="table-header">
                        <engine:Label text="RANK"   class="col-header col-rank" />
                        <engine:Label text="PLAYER" class="col-header col-player" />
                        <engine:Label text="TOPIC"  class="col-header col-topic" />
                        <engine:Label text="SCORE"  class="col-header col-score" />
                    </engine:VisualElement>

                    <engine:ScrollView class="row-list" name="row-list" />
                </engine:VisualElement>

                <engine:VisualElement name="page-settings" class="page page-placeholder hidden">
                    <engine:Label text="(Settings page belum dimigrate)" class="page-placeholder-text" />
                </engine:VisualElement>

                <engine:VisualElement name="page-help" class="page page-placeholder hidden">
                    <engine:Label text="(Get Help page belum dimigrate)" class="page-placeholder-text" />
                </engine:VisualElement>

            </engine:VisualElement>
        </engine:VisualElement>
    </engine:VisualElement>
</engine:UXML>
