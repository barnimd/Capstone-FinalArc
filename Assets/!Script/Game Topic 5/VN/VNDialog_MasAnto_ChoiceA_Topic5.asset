  lines:
  - speaker: 0
    mood: 0
    expression: {fileID: 0}
    text: Saya sudah panggil staff.
    voiceClip: {fileID: 8300000, guid: ca2b3139bb9b27244aef1119e4281508, type: 3}
  - speaker: 1
    mood: 2
    expression: {fileID: 0}
    text: Eh tunggu, ini salah paham...
    voiceClip: {fileID: 8300000, guid: f531711d6958e524e91a4ac6ff16effc, type: 3}
  - speaker: 2
    mood: 0
    expression: {fileID: 0}
    text: Pak Hendra masuk bersama security kafe.
    voiceClip: {fileID: 0}
  - speaker: 3
    mood: 0
    expression: {fileID: 0}
    text: Bapak harus ikut kami bicara dulu. Perangkat ini akan kami amankan.
    voiceClip: {fileID: 8300000, guid: 9197f917ee115ca48899a3750db447df, type: 3}
  - speaker: 1
    mood: 0
    expression: {fileID: 0}
    text: Iya iya... aku matiin.
    voiceClip: {fileID: 8300000, guid: 599450470b631e64a8fb149b2375f074, type: 3}
  - speaker: 2
    mood: 0
    expression: {fileID: 0}
    text: Router dimatikan. Semua jaringan palsu menghilang dari daftar.
    voiceClip: {fileID: 0}
